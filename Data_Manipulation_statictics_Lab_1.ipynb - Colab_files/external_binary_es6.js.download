function X$b(a,b,c,d){return n(function*(){var e,f=yield(e=a.debugAdapter)==null?void 0:l0(e),g;e=new Map(f==null?void 0:(g=f.body)==null?void 0:g.variables.map(u=>[u.name,u]));var {prompt:h,context:k,contextFiles:m}=Y$b(b,a.notebook.getCells(),c,d,!1,a.cell,e);g=[...c.getOptions().getStopSequencesList()];var r;return{prompt:h,preamble:c.getPreamble(),fewshotExamples:U_(d),contextFiles:m,stopSequences:g,maxTokens:asb?void 0:(r=c.getOptions())==null?void 0:r.getMaxTokens(),context:k}})}
var $$b=class extends oq{constructor(a,b,c){super();this.notebook=a;this.cell=b;this.debugAdapter=c}createRequest(a,b,c){var d=this;return n(function*(){var e,f=yield(e=d.debugAdapter)==null?void 0:l0(e),g;e=new Map(f==null?void 0:(g=f.body)==null?void 0:g.variables.map(C=>[C.name,C]));if(b==="r"){if(EL){var h=O$b||(O$b=$_('["\\u003cctrl99\\u003esystem\\nYou are an expert software engineer and data scientist with expertise in R, Google Colaboratory and Jupyter notebooks. You will follow these rules strictly.\\n\\n- Use 2 spaces for indentation\\n- Given ### Preceding code, and ### Task, respond with code that works with Google Colaboratory or Jupyter Notebooks only\\n- Use only the ### Preceding code that is provided immediately before ### Task. Preceding code may be None\\n- Be sure to import libraries with library() if they are not imported in ### Context.\\n- You can install libraries with install.packages() if they are not installed in ### Context.\\n- If responding with plain text, make sure they are R comments.\\n- Preceding code may not always be relevant to the Task. If it is not relevant or is None, you must write code that does not have previous context. If it is relevant, write code with preceding code as context\\n- ### Code: should only contain valid R code, no markdown. Comments are allowed.\\u003cctrl100\\u003e","\\n\\n","\\u003cctrl99\\u003euser\\n### Preceding code:\\n[[preceding]]\\n### Task:\\n[[task]]\\n### Code:\\u003cctrl100\\u003e\\n\\u003cctrl99\\u003emodel\\n```r\\n[[answer]]\\n```\\u003cctrl100\\u003e",[null,null,512,["```"]]]'));
h=V$b(h);e=Z_(N$b());return X$b(d,a,h,e)}h=R$b||(R$b=$_('["\\u003cctrl99\\u003esystem\\nYou are an expert software engineer and data scientist with expertise in R, Google Colaboratory and Jupyter notebooks. You will follow these rules strictly.\\n\\n- Use 2 spaces for indentation\\n- Given preceding code, and task, respond with code that works with Google Colaboratory or Jupyter Notebooks only\\n- Be sure to import libraries with library() if they are not already imported.\\n- You can install libraries with install.packages() if they are not already installed.\\n- If responding with plain text, make sure they are R comments.\\n- Preceding code may not always be relevant to the Task. If it is not relevant, you must write code that does not have previous context. If it is relevant, write code with preceding code as context\\n- Returned code should only contain valid R code, no markdown. Comments are allowed.\\n- In your response, do not repeat the provided preceding code, and just give the new code.\\u003cctrl100\\u003e\\n","\\n\\n","\\u003cctrl99\\u003euser\\n### Preceding code:\\n[[preceding]]\\n### Task:\\n[[task]]\\n### Code:\\u003cctrl100\\u003e\\n\\u003cctrl99\\u003emodel\\n```r\\n[[answer]]\\n```\\u003cctrl100\\u003e",[null,null,512,["```"]]]'));
var k=Z_(N$b());let {context:C,contextFiles:D}=Y$b(a,d.notebook.getCells(),h,k,!1,d.cell,e);var m;return{prompt:a,preamble:h.getPreamble(),fewshotExamples:U_(k),contextFiles:D,maxTokens:asb?void 0:(m=h.getOptions())==null?void 0:m.getMaxTokens(),context:C}}m=Q$b||(Q$b=$_('["\\u003cctrl99\\u003esystem\\nYou are an expert software engineer and data scientist with expertise in Python, Google Colaboratory and Jupyter notebooks. You will follow these rules strictly.\\n\\n- Use 2 spaces for indentation.\\n- Given preceding code, and task, respond with code that works with Google Colaboratory or Jupyter Notebooks only.\\n- Prefix all shell commands with `!` e.g., `pip install` will become `!pip install`.\\n- Shell commands are never indented, no whitespace at the beginning of the line.\\n- Do not have a whitespace at the beginning of a new line unless it is valid indentation.\\n- Import libraries if they are not imported.\\n- Install libraries if they are not installed.\\n- Preceding code may not always be relevant to the Task. If it is not relevant, you must write code that does not have previous context. If it is relevant, write code with preceding code as context.\\n- Returned code should only contain valid Python code, no markdown. Comments are allowed.\\n- In your response, do not repeat the provided preceding code, and just give the new code.\\u003cctrl100\\u003e\\n","\\n\\n","\\u003cctrl99\\u003euser\\n### Preceding code:\\n[[preceding]]\\n### Task:\\n[[task]]\\n### Answer with code:\\u003cctrl100\\u003e\\n\\u003cctrl99\\u003emodel\\n```python\\n[[answer]]\\n```\\u003cctrl100\\u003e",[null,null,2048,["```"]]]'));
g=Z$b(Z_(K$b||(K$b=$_('[null,null,null,null,[[[["task","import a csv"],["preceding","None"],["answer","import csv\\nwith open(\'data.csv\', \'r\') as f:\\n  reader \\u003d csv.reader(f)\\n  for row in reader:\\n    print(row)"]],["import"]],[[["task","list files on runtime"],["preceding","None"],["answer","!ls -a"]],["shell"]],[[["task","import a spreadsheet from google sheets"],["preceding","None"],["answer","from google.colab import auth\\nauth.authenticate_user()\\n# import the gspread library\\nimport gspread\\nfrom google.auth import default\\ncreds, _ \\u003d default()\\ngc \\u003d gspread.authorize(creds)\\nworksheet \\u003d gc.open(\'Your spreadsheet name\').sheet1\\n# get_all_values gives a list of rows.\\nrows \\u003d worksheet.get_all_values()\\nprint(rows)\\n# Convert to a DataFrame and render.\\nimport pandas as pd\\npd.DataFrame.from_records(rows)"]],["googleAPIs","import"]],[[["task","how to install conga"],["preceding","None"],["answer","!pip install conga"]],["shell"]],[[["task","print working directory"],["preceding","None"],["answer","!pwd"]],["shell"]],[[["task","git clone a project"],["preceding","None"],["answer","!git clone -l -s git://github.com/jakevdp/PythonDataScienceHandbook.git cloned-repo\\n%cd cloned-repo\\n!ls"]],["shell"]],[[["task","print the contents from a file"],["preceding","filename.txt"],["answer","!cat filename.txt"]],["shell"]],[[["task","search file contents for a string"],["preceding","filename.txt"],["answer","!grep string filename.txt"]],["shell"]],[[["task","count the lines in a file on runtime"],["preceding","filename.txt"],["answer","!wc -l filename.txt"]],["shell"]],[[["task","open files from the runtime"],["preceding","None"],["answer","from google.colab import files\\n\\nuploaded \\u003d files.upload()\\n\\nfor fn in uploaded.keys():\\n  print(\'User uploaded file \\"{name}\\" with length {length} bytes\'.format(\\n      name\\u003dfn, length\\u003dlen(uploaded[fn])))"]],["shell"]],[[["task","import files from GCS"],["preceding","None"],["answer","from google.colab import auth\\nauth.authenticate_user()\\n\\n# https://cloud.google.com/resource-manager/docs/creating-managing-projects\\nproject_id \\u003d \'[your Cloud Platform project ID]\'\\n!gcloud config set project {project_id}\\n\\n# Download the file from a given Google Cloud Storage bucket.\\n!gcloud storage cp gs://{bucket_name}/file_to_download.txt /tmp/gsutil_download.txt"]],["googleAPIs","import"]],[[["task","write files to GCS"],["preceding","None"],["answer","import uuid\\n\\n# Make a unique bucket to which we\'ll upload the file.\\n# (GCS buckets are part of a single global namespace.)\\nbucket_name \\u003d \'colab-sample-bucket-\' + str(uuid.uuid1())\\n\\n# Full reference: https://cloud.google.com/storage/docs/gsutil/commands/mb\\n!gcloud storage buckets create gs://{bucket_name}\\n\\n# Copy the file to our new bucket.\\n# Full reference: https://cloud.google.com/storage/docs/gsutil/commands/cp\\n!gcloud storage cp /tmp/to_upload.txt gs://{bucket_name}/\\n  \\n# Finally, dump the contents of our newly copied file to make sure everything worked.\\n!gcloud storage cat gs://{bucket_name}/to_upload.txt"]],["googleAPIs","export"]],[[["task","mount google drive"],["preceding","None"],["answer","from google.colab import drive\\ndrive.mount(\'/content/drive\')"]],["googleAPIs"]],[[["task","write a file to google drive"],["preceding","None"],["answer","with open(\'/content/drive/My Drive/foo.txt\', \'w\') as f:\\n  f.write(\'Hello Google Drive!\')\\n!cat /content/drive/My\\\\ Drive/foo.txt"]],["googleAPIs","export"]],[[["task","write data to a google sheet"],["preceding","None"],["answer","from google.colab import auth\\nauth.authenticate_user()\\n\\nimport gspread\\nfrom google.auth import default\\ncreds, _ \\u003d default()\\n\\ngc \\u003d gspread.authorize(creds)\\n\\nsh \\u003d gc.create(\'My cool spreadsheet\')\\n\\nworksheet \\u003d gc.open(\'My cool spreadsheet\').sheet1\\n\\ncell_list \\u003d worksheet.range(\'A1:C2\')\\n\\nimport random\\nfor cell in cell_list:\\n  cell.value \\u003d random.randint(1, 10)\\n\\nworksheet.update_cells(cell_list)"]],["googleAPIs","export"]],[[["task","download file in workspace"],["preceding","None"],["answer","from google.colab import files\\nfiles.download(\'example.txt\')"]],["export"]],[[["task","Write a function to identify non-prime numbers"],["preceding","None"],["answer","import math\\ndef is_not_prime(n):\\n    result \\u003d False\\n    for i in range(2,int(math.sqrt(n)) + 1):\\n        if n % i \\u003d\\u003d 0:\\n            result \\u003d True\\n    return result"]],["general"]],[[["task","Write a function to find the largest integers from a given list of numbers using heap queue algorithm."],["preceding","None"],["answer","import heapq as hq\\ndef heap_queue_largest(nums,n):\\n  largest_nums \\u003d hq.nlargest(n, nums)\\n  return largest_nums"]],["general"]],[[["task","Write a function to check if the given number is woodall or not."],["preceding","None"],["answer","def is_woodall(x): \\n  if (x % 2 \\u003d\\u003d 0): \\n    return False\\n  if (x \\u003d\\u003d 1): \\n    return True\\n  x \\u003d x + 1 \\n  p \\u003d 0\\n  while (x % 2 \\u003d\\u003d 0): \\n    x \\u003d x/2\\n    p \\u003d p + 1\\n    if (p \\u003d\\u003d x): \\n      return True\\n  return False"]],["general"]],[[["task","Write a function to remove characters from the first string which are present in the second string."],["preceding","None"],["answer","NO_OF_CHARS \\u003d 256\\ndef str_to_list(string): \\n  temp \\u003d [] \\n  for x in string: \\n    temp.append(x) \\n  return temp \\ndef lst_to_string(List): \\n  return \'\'.join(List) \\ndef get_char_count_array(string): \\n  count \\u003d [0] * NO_OF_CHARS \\n  for i in string: \\n    count[ord(i)] +\\u003d 1\\n  return count \\ndef remove_dirty_chars(string, second_string): \\n  count \\u003d get_char_count_array(second_string) \\n  ip_ind \\u003d 0\\n  res_ind \\u003d 0\\n  temp \\u003d \'\' \\n  str_list \\u003d str_to_list(string) \\n  while ip_ind !\\u003d len(str_list): \\n    temp \\u003d str_list[ip_ind] \\n    if count[ord(temp)] \\u003d\\u003d 0: \\n      str_list[res_ind] \\u003d str_list[ip_ind] \\n      res_ind +\\u003d 1\\n    ip_ind+\\u003d1\\n  return lst_to_string(str_list[0:res_ind]) \\n"]],["general"]],[[["task","create an input text field and assign it to a variable"],["preceding","None"],["answer","foo \\u003d \\"\\" #@param {type:\\"string\\"}"]],["jupyter"]],[[["task","create a slider and assign it to a variable"],["preceding","None"],["answer","foo \\u003d 1 #@param {type:\\"slider\\", min:1, max:10, step:1}"]],["jupyter"]],[[["task","create a dropdown with 3 random countries, with the first option as default"],["preceding","None"],["answer","foo \\u003d \\"United States\\" #@param [\\"United States\\", \\"China\\", \\"Greece\\"]"]],["jupyter"]],[[["task","print hello and world"],["preceding","hello \\u003d \\"hello \\"\\nworld \\u003d \\"world\\"\\n"],["answer","print(hello + world)"]],["general"]],[[["task","generate a panda dataframe using col1 and col2"],["preceding","col1 \\u003d [1, 2]\\ncol2 \\u003d [3, 4]\\n"],["answer","import pandas as pd\\n\\ndata \\u003d {\'col1\': col1, \'col2\': col2}\\ndf \\u003d pd.DataFrame(data)\\n\\nprint(df)\\n"]],["general"]]]]'))),
c!=null?c:[]);c&&c.filter(C=>W$b.includes(C)).length>0&&(m=J$b(),g=Z_(m));f=!1;if((k=Rm)==null?0:k.USES_FIRST_PARTY_AI_CONTEXT)rtb&&(m=P$b||(P$b=$_("[\"\\u003cctrl99\\u003esystem\\nAdhoc Import\\n\\nLoad this as a notebook in Colab\\n\\ngo/adhoc-import\\nNote on Usage\\nAdhoc Import is a best-effort solution that does not work in all cases. Using a custom go/colab_binary is the best solution for reliably including dependencies in your runtime.\\n\\nCanonical location: http://go/colab-adhoc-import\\n\\nadhoc_import is a colabtools library that allows you to import Python code in your Colab environment without building a custom runtime. This works for both local and Borg runtimes, as long as the runtime is running as a user with go/p4-access.\\n\\nTypical uses of adhoc_import include:\\n\\nQuickly iterating on a notebook with a set of dependencies that you can't list a priori.\\nImporting a library that you're actively working on in a separate editor (Python, proto, other).\\nWorking with protos outside the global DB, e.g., protos in //experimental.\\nIf you're looking for other ways to share code between notebooks, see the code reuse notebook.\\n\\nCode that you bring into your notebook using adhoc_import often graduates to a normal py_library BUILD rule once it's complete. We recommend this for mature code, since this greatly simplifies reuse and maintenance, e.g., your peers can reuse the library outside of Colab, and you can easily write standard Python unit tests.\\n\\nThe adhoc_import library is imported just like any other, but it must be initialized before use, and the process of initialization depends on your environment. See the examples below for typical usage.\\n\\n\\nFor more information about how adhoc_import works, see the file-level comment at the top of http://google3/research/colab/public/adhoc_import.py.\\n\\nadhoc_import at the runtime's build CL\\nThe most common use of adhoc_import is to import code from google3 that isn't already included in your runtime. This works for pure Python code, as well as any code all of whose SWIG'd dependencies are already included in your notebook binary.\\n\\nThe easiest way to adhoc_import at the runtime's build CL is to use Google3SubmittedChangelist() without passing an argument for number as shown below. This will default number to build_data.BaselineChangelist() which is equivalent to the runtime's build CL.\\n\\n```python\\nfrom colabtools import adhoc_import\\n\\nwith adhoc_import.Google3SubmittedChangelist():\\n# Now we can import pure-python code from anywhere in google3, including experimental.\\n#\\n# NOTE: anything with a (transitive) build-requiring dependency such as C++\\n# code, protocol buffers, etc. that isn't already built in to the colab_binary\\n# requires a build_targets\\u003d param. See go/adhoc-build below.\\nfrom google3.pyglib import gfile\\nfrom google3.experimental.colab.example.adhoc_import.birthday import birthday\\n\\nprint('\\nThe file being imported contains:\\n')\\nprint(gfile.Open('/google_src/head/depot/google3/experimental/colab/example/adhoc_import/birthday.py').read())\\n\\nprint('Calling the imported birthday() function yields:')\\nprint(birthday('you, from my workstation'))\\n```\\nadhoc_import from third_party\\nTo import code that lies in google3/third_party/ the import does not require the complete path but it can be imported by simply stating the library that lies within google3/third_party/py/.\\n\\n```python\\nfrom colabtools import adhoc_import\\nwith adhoc_import.Google3SubmittedChangelist():\\n# here importing colorama from google3/third_party/py/\\nimport colorama\\n\\nfrom colorama import Fore, Back, Style\\nprint(f'{Fore.RED}some red text')\\nprint(f'{Back.BLUE}with a blue background')\\nprint(f'{Style.RESET_ALL}back to normal now')\\n```\\nadhoc_import with non-python deps (go/adhoc-build)\\nCode that requires a blaze build before use, such as.proto files that'll generate _pb2.py files, can be adhoc_import'd by specifying build_targets\\u003d. The blaze build is executed using go/buildrabbit. To see what rabbit is doing add verbose\\u003dTrue. To use the built artifacts instead of checked-in artifacts, add behavior\\u003d'preferred'. The example below demonstrates some common target types that might require building before use: py_binary which consumes a genrule's output, py_proto_library, py_wrap_cc (SWIG), and py_clif_cc.\\n\\nNOTE: if build_targets\\u003d-specified targets require InitGoogle() (e.g. File implementations), make sure to pass generated outputs to InitGoogleIfPresent() as demonstrated below.\\n\\nNOTE: merely building proto targets (e.g. _py_pb2) only makes them available to import statements inside the adhoc context. In particular neither building nor calling InitGoogleIfPresent() will register built protos with existing descriptor pools. See example pitfall with workaround.\\n\\nNOTE: none of py_clif_cc, py_wrap_cc, and py_library are useful to specify to build_targets\\u003d because those BUILD target types don't emit standalone artifacts (a property of blaze, not of colab or adhoc_import). If you want to adhoc_import the contents of such targets, depend on them from a py_binary or py_test target and specify that target in build_targets\\u003d, instead.\\n\\nNOTE: the example below builds at the CL that the kernel was built at, to avoid version skew. To build at a different CL, accepting the attendant risks, replace the comment line including build_data.BaselineChangelist() below with the different CL you'd like to use.\\n\\n```python\\nfrom colabtools import adhoc_import\\n\\nwith adhoc_import.Google3SubmittedChangelist(\\nbuild_targets\\u003d[\\n'//research/colab/guitar/adhoc_import:get_generated',\\n'//research/colab/guitar/adhoc_import:demo_py_pb2',\\n'//research/colab/guitar/adhoc_import:greet_from_clif_no_launcher_py3'\\n],\\nbehavior\\u003d'preferred') as outputs:\\nfor cdll in outputs.cdlls:\\nadhoc_import.InitGoogleIfPresent(cdll)\\n\\nfrom google3.research.colab.guitar.adhoc_import import get_generated\\nprint(get_generated.GetData().decode())\\n\\nfrom google3.research.colab.guitar.adhoc_import import demo_pb2\\n# Available as a transitive dep of demo_pb2 above, even though we never\\n# explicitly requested a build of.../other:other_py_pb2!\\nfrom google3.research.colab.guitar.adhoc_import.other import other_pb2\\no \\u003d other_pb2.OtherMessage(a\\u003d'world')\\nd \\u003d demo_pb2.DemoMessage(a\\u003d'hello')\\nd.b.MergeFrom(o)\\nprint(str(d))\\n\\nfrom google3.research.colab.guitar.adhoc_import.python import greeter\\nprint(greeter.GreetFromClif())\\n```\\nadhoc_import with pending code in a citc client\\nYou can load code in a pending citc client. In this case, we've added a new function in the citc client externalcode-notebook.\\n\\n```python\\ndef hello(name):\\nreturn 'Hello, ' + name\\n```\\nGoogle3CitcClient() takes an optional username, so you can also import code from other users' CitC clients.\\n\\n```python\\nfrom colabtools import adhoc_import\\nfrom importlib import reload\\n\\nwith adhoc_import.Google3CitcClient('CLIENT_NAME'):\\nfrom google3.experimental.colab.example.adhoc_import import birthday\\nbirthday \\u003d reload(birthday)\\n\\nprint(birthday.birthday('user'))\\n```\\nYou may also use the snapshot parameter to specify a specific snapshot of the client. Valid parameter values include:\\n\\nNone (default): most recent client state.\\n'head': a recent snapshot, may differ from that returned by None; unlikely to be what you want (see b/112057879).\\n\\u003cnumber\\u003e: each snapshot receives a number that counts up from some low value; you can identify your client's snapshot number with the shell command citctools info.\\n'@\\u003ctimestamp\\u003e': the most recent snapshot at this UNIX timestamp.\\n'\\u003cunit\\u003es.ago/\\u003cnumber\\u003e': the most recent snapshot as \\u003cnumber\\u003e \\u003cunits\\u003e prior to now, where \\u003cunit\\u003e is 'day', 'hour', 'minute', or 'second'.\\n```python\\nfrom colabtools import adhoc_import\\nfrom importlib import reload\\n\\nwith adhoc_import.Google3CitcClient('CLIENT_NAME', snapshot\\u003d'seconds.ago/5'):\\nfrom google3.experimental.colab.example.adhoc_import import birthday\\nbirthday \\u003d reload(birthday)\\n\\nprint(birthday.birthday('user'))\\n```\\nadhoc_import and code from a past CL\\nTo import code from a specific past CL, perhaps to experiment with deleted code, use Google3SubmittedChangelist(). Be careful not to use it with an in-progress CL# (in that case, use Google3CitcClient, above). (Note that if you want to get an old version of a file that has not been deleted, you may need behavior\\u003d'preferred' below.)\\n\\n```python\\nfrom colabtools import adhoc_import\\n\\nwith adhoc_import.Google3SubmittedChangelist(104999830):\\n# past_lib is used in our tests, and was deleted after the above CL#.\\nfrom google3.research.colab.testdata import past_lib\\n\\nprint('Number of dinosaur genera is: %d.' % past_lib.NumberOfDinosaurGenera())\\n```\\nadhoc_import and flags\\nSometimes, you will want to reload code that has flag definitions. Ordinarily, this will fail because flags cannot be defined twice. adhoc_import includes a Reload() function similar to importlib.reload() for this purpose. If you replace my_mod \\u003d importlib.reload(my_mod) with my_mod \\u003d adhoc_import.Reload(my_mod, reset_flags\\u003dTrue), flags will be unloaded from my_mod before reloading.\\n\\n```python\\nadhoc_import.Initialize instead of a with-statement\\nIf you want to always fall back to importing from Google3, you can use the Initialize() form. You should generally prefer the with adhoc_import.Google3SubmittedChangelist() form illustrated above, however, as it will make errors more clear. with adhoc_import.Google3Head() is almost exactly the same as adhoc_import.Initialize() followed by adhoc_import.Stop().\\n\\nfrom colabtools import adhoc_import\\n\\n# Initialize() will default to using Srcfs HEAD if no argument is given.\\n# We print a warning about this behavior.\\n# To avoid the warning, specify an explicit google3 directory or use the\\n# adhoc_import.InitializeFromSrcfs() form which takes no arguments.\\nadhoc_import.Initialize()\\n\\n# Now google3 will always be checked as a last choice if a module cannot\\n# be found.\\nfrom google3.experimental.colab.example.adhoc_import.birthday import birthday\\n\\nprint('Calling the imported birthday() function yields:')\\nprint(birthday('you, from Initialize!'))\\n\\n# You can get out of the always-on Initialize mode by calling Stop().\\nadhoc_import.Stop()\\n```\\nadhoc_import import order preference\\nadhoc_import's functions can take a behavior\\u003d'preferred' keyword argument. The default import behavior is behavior\\u003d'fallback', which means that we will only try to use adhoc_import to do the import if the module is not available anywhere else (e.g., in the binary the user is running, in sys.path). However, sometimes you would like to prefer the adhoc_import location, especially if it is a Google3CitcClient with updated code or a Google3SubmittedChangelist with old code. Setting behavior\\u003d'preferred' will attempt to load modules from adhoc_import first before other entries in sys.path, but it may not work for a variety of reasons (see the file-level docstring in adhoc_import.py for details). Sometimes you'll want behavior\\u003d'preferred' for updated code, but not to let the setting apply to the complete transitive closure of the imported code; for a way of coping with this situation see package_restrict\\u003d in the above file-level docstring.\\n\\nadhoc_import from an MPM\\nIt's hacky and risks version skew, but this thread demonstrates how to adhoc_import from an MPM package. This can be a good idea if build_targets\\u003d takes too long to run, or if you'd like to package up a particular set of dependencies/versions.\\n\\nadhoc_import troubleshooting\\nVersion Skew\\nThe most common source of pain for users when adhoc_importing, especially.proto's or native code (either directly or transitively), is version skew. If foo.proto is built into the colab_binary() at CL N, and then a field is added to a message in that file and the file adhoc_import'd at CL M, then the message type won't be reloaded, and references to the new field will result in python errors. The inability to reload an already-loaded message type is tracked by public issue and examples of this sort of failure can be seen e.g. in 1 and 2 and 3.\\n\\nWARNING: Protobuf is banning the version skews explicitly, and you will see a warning like WARNING: Protobuf Python version check is disabled when adhoc_importing Python protos. In the near future, we will switch to enabling the Protobuf version check by default, and error out any unsupported version skews according to go/proto-x-version-runtime. This will mostly impact proto imports with Google3CitcClient. You will then need to explicitly set the disabling flag which we will provide later (TODO(b/335205064)) in order to proceed. If you still see a Protobuf version error, try setting disable_proto_version_check\\u003dadhoc_import.ProtoVersionCheck.DISABLED in the adhoc_import.Google3XXX to disable version checks for transitively-imported protos.\\n\\nSimilarly, if the ABI of a symbol changes (class layout, function arguments, etc) between the CL the kernel was built and the CL used for the adhoc_import build, a kernel crash becomes likely as wild pointers are followed (e.g. bug).\\n\\nFix both sorts of problems by either waiting for the kernel to catch up (usually requiring a restart of the borg job after the new field makes it into a production kernel according to http://rapid/colab) or adhoc_importing from the same CL the kernel was built at, e.g. like:\\n\\n```python\\nwith adhoc_import.Google3SubmittedChangelist(...):\\n# Defaults to build at build_data.BaselineChangelist(), the runtime's CL\\n...\\n```\\nReload\\nCalls to the same import statement after the first are no-ops in python. For adhoc_import usages, this means that importing a file, then editing it and trying to import it again will result in apparently no edits having been made. Resolve this by using importlib.reload(), inside the adhoc_import context where the import is done, and by passing behavior\\u003d'preferred' to the build scope. E.g.:\\n\\n```python\\nfrom importlib import reload\\nwith adhoc_import.Google3SubmittedChangelist(..., behavior\\u003d'preferred'):\\nfrom google3.my.project import coolmodule\\ncoolmodule \\u003d reload(coolmodule)\\n...\\n```\\nInitGoogle\\nMost google3 C++ code relies on static initialization to work correctly, and this initialization is traditionally driven through initializers registered (implicitly as in flags, or explicitly) to be executed by InitGoogle(). When using adhoc_import(build_targets\\u003d) on such code run InitGoogleIfPresent() as shown elsewhere in this notebook.\\n\\nDouble linkage\\nWhen using build_targets\\u003d it's possible to (transitively) build compiled code that is already also linked in to the colab_binary. Doing so will usually result in crashes because the compilation flags are slightly different. An example is https://yaqs.corp.google.com/eng/q/5125201365565440#n5685265389584384. There isn't a great workaround for this; either include the build_targets\\u003d in the colab_binary (losing some/all of the benefit of adhoc_import) or prevent the doubly-linked lib from being built into the colab_binary (not always possible).\\n\\nPython CLIF\\nadhoc_import is not reliable when importing CLIF managed objects, and the error message can confuse the user. An example is http://yaqs/2342887754976722944. One case was explained here http://yaqs/6474196562083840#a6189042945884160. Use custom go/colab_binary instead.\\n\\nBuild takes a long time to start\\nadhoc_import-driven builds (through buildrabbit API) are subject to the Build Queue as of 2018/01/11. Each build will emit two lines like\\n\\nBuild bbq-d136dea6-de3e-4fef-ba73-784ae6ef98b6 was enqueued for 1.621s. See go/bbqid?uuid\\u003dbbq-d136dea6-de3e-4fef-ba73-784ae6ef98b6 for more information about your request.\\n\\n(one for the useless-target check and one for the build itself). If either indicates a request was enqueued for longer than a few seconds that probably means your PA is underprovisioned for Forge resources, or that there's a problem afoot. To see if it's just you, check the dashboard. Contact colab-team@ if you think there's a problem.\\n\\n\\n\\nAltair\\n\\nLoad this as a notebook in Colab\\n\\nVisualization: Interactive Scatter Plot in Altair\\nAltair lets you easily create an interactive scatter plot from data stored in a Pandas dataframe.\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\n# plot the dataset, referencing dataframe column names\\nimport altair as alt\\nalt.Chart(cars).mark_point().encode(\\nx\\u003d'Horsepower',\\ny\\u003d'Miles_per_Gallon',\\ncolor\\u003d'Origin'\\n).interactive()\\n```\\nVisualization: Bar Plot in Altair\\nThis shows a simple bar plot in Altair, showing the mean miles per gallon as a function of origin for a number of car models:\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\n# plot the dataset, referencing dataframe column names\\nimport altair as alt\\nalt.Chart(cars).mark_bar().encode(\\nx\\u003d'mean(Miles_per_Gallon)',\\ny\\u003d'Origin',\\ncolor\\u003d'Origin'\\n)\\n```\\nVisualization: Histogram in Altair\\nAltair provides a variety of aggregation operations in order to build custom histograms. Here is a simple example\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\n# plot the dataset, referencing dataframe column names\\nimport altair as alt\\nalt.Chart(cars).mark_bar().encode(\\nx\\u003dalt.X('Miles_per_Gallon', bin\\u003dTrue),\\ny\\u003d'count()',\\n)\\n```\\nVisualization: Stacked Histogram in Altair\\nIf you take a standard histogram and encode another field with color, the result will be a stacked histogram:\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\n# plot the dataset, referencing dataframe column names\\nimport altair as alt\\nalt.Chart(cars).mark_bar().encode(\\nx\\u003dalt.X('Miles_per_Gallon', bin\\u003dTrue),\\ny\\u003d'count()',\\ncolor\\u003d'Origin'\\n)\\n```\\nVisualization: Scatter Plot with Rolling Mean in Altair\\nThis shows a scatter chart of miles per gallon as a function of year, with lines inidicating the mean values for each country within the given year.\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\nimport altair as alt\\n\\npoints \\u003d alt.Chart(cars).mark_point().encode(\\nx\\u003d'Year:T',\\ny\\u003d'Miles_per_Gallon',\\ncolor\\u003d'Origin'\\n).properties(\\nwidth\\u003d800\\n)\\n\\nlines \\u003d alt.Chart(cars).mark_line().encode(\\nx\\u003d'Year:T',\\ny\\u003d'mean(Miles_per_Gallon)',\\ncolor\\u003d'Origin'\\n).properties(\\nwidth\\u003d800\\n).interactive(bind_y\\u003dFalse)\\n\\npoints + lines\\n```\\nVisualization: Interactive Brushing in Altair\\nWith a few extra lines of code on top of a standard scatter plot, you can add selection behavior to your scatter plot. This lets you click and drag to select points.\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\nimport altair as alt\\n\\ninterval \\u003d alt.selection_interval()\\n\\nalt.Chart(cars).mark_point().encode(\\nx\\u003d'Horsepower',\\ny\\u003d'Miles_per_Gallon',\\ncolor\\u003dalt.condition(interval, 'Origin', alt.value('lightgray'))\\n).properties(\\nselection\\u003dinterval\\n)\\n```\\nVisualization: Linked Brushing in Altair\\nIf you apply the same selection to multiple panels of an Altair chart, the selections will be linked:\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\nimport altair as alt\\n\\ninterval \\u003d alt.selection_interval()\\n\\nbase \\u003d alt.Chart(cars).mark_point().encode(\\ny\\u003d'Miles_per_Gallon',\\ncolor\\u003dalt.condition(interval, 'Origin', alt.value('lightgray'))\\n).properties(\\nselection\\u003dinterval\\n)\\n\\nbase.encode(x\\u003d'Acceleration') | base.encode(x\\u003d'Horsepower')\\n```\\nVisualization: Linked Scatter-Plot and Histogram in Altair\\nAltair selections can be used for a variety of things. This example shows a scatter plot and a histogram with selections over both that allow exploring the relationships between points\\n\\n```python\\n# load an example dataset\\nfrom vega_datasets import data\\ncars \\u003d data.cars()\\n\\nimport altair as alt\\n\\ninterval \\u003d alt.selection_interval()\\n\\npoints \\u003d alt.Chart(cars).mark_point().encode(\\nx\\u003d'Horsepower',\\ny\\u003d'Miles_per_Gallon',\\ncolor\\u003dalt.condition(interval, 'Origin', alt.value('lightgray'))\\n).properties(\\nselection\\u003dinterval\\n)\\n\\nhistogram \\u003d alt.Chart(cars).mark_bar().encode(\\nx\\u003d'count()',\\ny\\u003d'Origin',\\ncolor\\u003d'Origin'\\n).transform_filter(interval)\\n\\npoints \\u0026 histogram\\n```\\nVisualization: Time Series Line Plot in Altair\\nAltair handles temporal types natively by using the:T type marker. An example is in this plot of stock prices over time\\n\\n```python\\nfrom vega_datasets import data\\nstocks \\u003d data.stocks()\\n\\nimport altair as alt\\nalt.Chart(stocks).mark_line().encode(\\nx\\u003d'date:T',\\ny\\u003d'price',\\ncolor\\u003d'symbol'\\n).interactive(bind_y\\u003dFalse)\\n```\\n\\n\\n\\n\\nCharting\\n\\nLoad this as a notebook in Colab\\n\\nMatplotlib line chart\\nReferences: - Documentation - Matplotlib gallery: lines bars and markers\\n\\n```python\\nimport matplotlib.pyplot as plt\\n\\ny \\u003d\\nplt.plot(y)\\nplt.show()\\n```\\nMatplotlib histogram\\nReferences: - Documentation - Matplotlib: histogram demo features - Matplotlib: histogram demo types\\n\\n```python\\nimport matplotlib.pyplot as plt\\nimport numpy as np\\n\\n# Use numpy to generate a bunch of random data in a bell curve around 5\\nn \\u003d 5 + np.random.randn(1000)\\n\\nplt.hist(n, bins\\u003d20)\\nplt.title('Histogram')\\nplt.show()\\n```\\nMatplotlib cumulative histogram\\nReferences: - Documentation - Matplotlib: histogram demo cumulative\\n\\n```python\\nimport matplotlib.pyplot as plt\\nimport numpy as np\\n\\n# Use numpy to generate a bunch of random data in a bell curve around 5\\nn \\u003d 5 + np.random.randn(1000)\\n\\nplt.hist(n, cumulative\\u003dTrue, bins\\u003d20)\\nplt.title('Cumulative histogram')\\nplt.show()\\n```\\nSeaborn\\nThere are several libraries layered on top of Matplotlib that you can use in Colab. One that is worth highlighting is Seaborn.\\n\\nSeaborn regression plot\\nA simple scatterplot with a nice regression line fit to it.\\n\\nReferences: - Documentation\\n\\n```python\\nimport matplotlib.pyplot as plt\\nimport numpy as np\\nimport seaborn as sns\\n\\n# Generate some random data\\nnum_points \\u003d 20\\n# x will be 5, 6, 7... but also twiddled randomly\\nx \\u003d 5 + np.arange(num_points) + np.random.randn(num_points)\\n# y will be 10, 11, 12... but twiddled even more randomly\\ny \\u003d 10 + np.arange(num_points) + 5 * np.random.randn(num_points)\\nsns.regplot(x\\u003dx, y\\u003dy)\\nplt.show()\\n```\\nSeaborn heatmap\\nReferences: - Documentation - [Example]((http://seaborn.pydata.org/examples/heatmap_annotation.html)\\n\\n```python\\nimport matplotlib.pyplot as plt\\nimport numpy as np\\nimport seaborn as sns\\n\\n# Make a 10 x 10 heatmap of some random data\\nside_length \\u003d 10\\n# Start with a 10 x 10 matrix with values randomized around 5\\ndata \\u003d 5 + np.random.randn(side_length, side_length)\\n# The next two lines make the values larger as we get closer to (9, 9)\\ndata +\\u003d np.arange(side_length)\\ndata +\\u003d np.reshape(np.arange(side_length), (side_length, 1))\\n# Generate the heatmap\\nsns.heatmap(data)\\nplt.show()\\n```\\nDisable seaborn and restore default matplotlib configuration\\nColab uses seaborn that provides nice default styling, however for some uses (e.g. for publications) it is preferable to restore the original matplotlib configuration.\\n\\nReferences: - Documentation\\n\\n```python\\nimport seaborn\\nseaborn.reset_orig()\\n```\\nPandas DataFrame: line chart\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# Create a random time series.\\nts \\u003d pd.Series(np.random.randn(1000), index\\u003dpd.date_range('1/1/2000', periods\\u003d1000))\\nts \\u003d ts.cumsum()\\nts.plot();\\n```\\nPandas DataFrame: Histogram\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with 4 columns and random values.\\ndf \\u003d pd.DataFrame(np.random.randn(50, 4), columns\\u003dlist('ABCD'))\\ndf.hist();\\n```\\nPandas DataFrame: Categorical Data Histogram\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with one categorical column.\\ndf \\u003d pd.DataFrame(np.random.choice(['apple', 'banana', 'orange', 'kiwi'], size\\u003d50), columns\\u003d['fruit'])\\ndf.fruit.value_counts().plot.bar();\\n```\\nPandas DataFrame: Rotate axis labels\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with one categorical column.\\ndf \\u003d pd.DataFrame(np.random.choice(['fruit with a very long name', 'banana', 'orange', 'looooooongfruit'], size\\u003d50), columns\\u003d['fruit'])\\ncounts \\u003d df.fruit.value_counts()\\nax \\u003d counts.plot.bar()\\nax.figure.canvas.draw()\\nxlabels \\u003d [item.get_text() for item in ax.get_xticklabels()]\\nax.set_xticklabels(xlabels, rotation\\u003d45, ha\\u003d'right');\\n```\\nPandas DataFrame: Plot Title and Axis Labels\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with one categorical column.\\ndf \\u003d pd.DataFrame(np.random.choice(['starfruit', 'grapefruit', 'pomegranate', 'boisenberry'], size\\u003d50), columns\\u003d['fruit'])\\ncounts \\u003d df.fruit.value_counts()\\nax \\u003d counts.plot.bar()\\nax.set_title('Fruits 2016Q4');\\nax.set_xlabel('Fruit name');\\nax.set_ylabel('Number of fruits');\\n```\\nPandas DataFrame: Bar Chart with Value Labels\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with one categorical column.\\ndf \\u003d pd.DataFrame(np.random.choice(['apple', 'banana', 'orange', 'kiwi'], size\\u003d50), columns\\u003d['fruit'])\\ncounts \\u003d df.fruit.value_counts()\\nax \\u003d counts.plot.bar()\\nrects \\u003d ax.patches\\nfor rect, label in zip(rects, counts):\\nheight \\u003d rect.get_height()\\nax.text(rect.get_x() + rect.get_width()/2, height, label, ha\\u003d'center', va\\u003d'bottom')\\n```\\nPandas DataFrame: Bar chart\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\n# A DataFrame with 4 columns and random values.\\ndf \\u003d pd.DataFrame(np.random.rand(10, 4), columns\\u003dlist('ABCD'))\\n\\n# Basic bar chart.\\ndf.plot.bar();\\n# Horizontal stacked bar chart.\\ndf.plot.barh(stacked\\u003dTrue);\\n```\\nPandas DataFrame: Box plot\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\ndf \\u003d pd.DataFrame(np.random.rand(10, 5), columns\\u003d['A', 'B', 'C', 'D', 'E'])\\ndf.plot.box();\\n```\\nPandas DataFrame: Area plot\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\ndf \\u003d pd.DataFrame(np.random.rand(10, 4), columns\\u003d['a', 'b', 'c', 'd'])\\ndf.plot.area();\\n```\\nPandas DataFrame: Scatter plot\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\ndf \\u003d pd.DataFrame(np.random.rand(50, 4), columns\\u003d['a', 'b', 'c', 'd'])\\ndf.plot.scatter(x\\u003d'a', y\\u003d'b');\\n```\\nPandas DataFrame: Hexagonal Bin Plot\\nHexbin plots can be a useful alternative to scatter plots if your data are too dense to plot each point individually.\\n\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\ndf \\u003d pd.DataFrame(np.random.randn(1000, 2), columns\\u003d['a', 'b'])\\ndf['b'] \\u003d df['b'] + np.arange(1000)\\ndf.plot.hexbin(x\\u003d'a', y\\u003d'b', gridsize\\u003d25);\\n```\\nPandas DataFrame: Pie chart\\nSee also: Pandas visualization\\n\\n```python\\nimport pandas as pd\\nimport numpy as np\\n\\nseries \\u003d pd.Series(3 * np.random.rand(4), index\\u003d['a', 'b', 'c', 'd'], name\\u003d'series')\\nseries.plot.pie(figsize\\u003d(6, 6));\\n```\\nunicode support in Matplotlib\\nNote that all the above charting libraries rely under the hood on Matplotlib, which has limited unicode support. In particular, the rendering engine of Matplotlib is different than your browser (see this yaqs discussion). There are two work-arounds for this:\\n\\nDon't use matplotlib and use native-rendering instead, like Altair.\\nLoad unicode libraries deliberately in your colab with the hack below.\\n```python\\n# @test {'skip': true}\\n# TODO(b/174078526): Update this snippet when noto is supported.\\nimport pandas as pd\\nfrom colabtools import adhoc_import\\nwith adhoc_import.Google3Head():\\nfrom google3.experimental.users.gaster.font.font_hack import find_font\\n\\nsource \\u003d pd.DataFrame({\\n'unicode': [u'\u7247', u'\u3053\u3093\u306b\u3061\u306f\u4e16\u754c', ],\\n'counts': [28, 55, ]\\n})\\n\\nax \\u003d source.plot.barh(stacked\\u003dTrue, x\\u003d'unicode')\\nfor tick in ax.get_yticklabels():\\ntick.set_fontname(find_font(tick._text)) # 'fixed'\\n```\\n(better) unicode supported charting\\nUse altair, which does not use matplotlib but rather uses your browser for rendering, so fonts just work.\\n\\n```python\\n# Altair doesn't use matplotlib, but uses your browser so it just works.\\nimport altair as alt\\nimport pandas as pd\\n\\nsource \\u003d pd.DataFrame({\\n'unicode': [u'\u7247', u'\u3053\u3093\u306b\u3061\u306f\u4e16\u754c', ],\\n'counts': [28, 55, ]\\n})\\nalt.Chart(source).mark_bar().encode(\\ny\\u003d'unicode',\\nx\\u003d'counts'\\n)\\n```\\n\\n\\n\\nDremel\\n\\nLoad this as a notebook in Colab\\n\\nDeprecation Warning\\nNote: per go/icm-dremel-f1 Dremel is a deprecated Query engine. Please use F1 instead.\\n\\nSetting Dremel SQL dialect\\nUse dremel.SetLanguage to configure the SQL dialect, either GoogleSQL or DremelSQL.\\n\\nGoogleSQL\\ngo/googlesql\\n# GoogleSQL\\n```python\\nfrom colabtools import dremel\\ndremel.SetLanguage('GoogleSQL')\\ndremel.ExecuteQuery('SELECT CURRENT_TIMESTAMP() as now')\\n```\\n```python\\n%%dremel_query\\nselect current_timestamp()\\n```\\nDremelSQL\\ngo/dremelsql\\n# DremelSQL\\n```python\\nfrom colabtools import dremel\\ndremel.SetLanguage('DremelSQL')\\ndremel.ExecuteQuery('SELECT NOW() as now')\\n```\\n```python\\n%%dremel_query\\nselect now()\\n```\\nSetting Dremel completion ratio\\nBy default, Dremel can return query results without processing 100% of the data. This is because Dremel tries to balance query execution time against data completeness: if a particular shard is slow to respond, Dremel will return a query result without that data, as long as it has at least a certain minimum amount of the data; the default minimum percentage is 98%.\\n\\nYou can modify your minimum data coverage by calling dremel.SetMinCompletionRatio.\\n\\n```python\\nfrom colabtools import dremel\\ndremel.SetMinCompletionRatio(0.99)\\n```\\nSetting Dremel accounting group\\nAn accounting group allows you to issue queries beyond the daily freebie quota and to use reserved slots.\\n\\n```python\\nfrom colabtools import dremel\\ndremel.SetAccountingGroup('your-mdb-group-here')\\n```\\nSave Dremel results to Sheets or CSV\\nThe result of a Dremel query is a Pandas DataFrame.\\n\\nSaving a DataFrame to sheets\\nTo save as CSV, use the to_csv function.\\n\\n```python\\n%%dremel_query result\\n# Save the top 10 baby names to the Python variable 'result'.\\nselect\\nbaby_name,\\nsum(num_babies) as count\\nfrom dremel_codelab.babynames\\ngroup by baby_name\\norder by count desc\\nlimit 10\\n```\\n```python\\n# Save the results to the file '/tmp/babynames.csv'\\nwith open('/tmp/babynames.csv', 'w') as f:\\nresult.to_csv(f)\\n```\\nLoad proto from the globaldb\\nDremel allows clients to add types from the global proto DB as extension modules via DremelConnection::AddProtoExtensionModule. In the Dremel shell, users can load global proto types using load globaldb:[fully.qualified.ProtoType]. An example follows.\\n\\n```python\\n%%dremel\\nload globaldb:photos.Person;\\nset sql_dialect GoogleSQL\\n\\nDEFINE INLINE TABLE T\\nSELECT 'tmeyer@google.com' AS email, 'Timothy Meyer' AS displayname\\nUNION ALL SELECT 'alice@google.com', 'Alice Alicington'\\nUNION ALL SELECT NULL, 'Lawyercat';\\n\\nSELECT\\nperson.displayname,\\nIF(person.has_email, person.email, '(no email provided)') AS email\\nFROM\\n(\\nSELECT NEW `photos.Person`(email, displayname) AS person FROM T\\n);\\n```\\nEquivalently, you can use the Python API directly.\\n\\n```python\\nfrom colabtools import dremel\\n\\ndremel.SetLanguage('GoogleSQL')\\ndremel.dremel_client.AddProtoExtensionModule('photos.Person')\\n```\\n```python\\n%%dremel_query\\nselect (new photos.Person(1 as user_id, 'abc123@gmail.com' as email))\\n```\\nUsing dremel credentials to delegate access to encrypted files\\nWe begin by creating sample encrypted data to be read.\\n\\n# Create an encrypted file\\n```python\\nfrom colabtools import dremel\\nfrom google3.pyglib import gfile\\nimport getpass\\n\\n\\n# The scope\\u003d18100 is required for Dremel to access the file.\\n#\\n# See: http://google3/gaia/mint/protos/apiscopecodes.proto?l\\u003d3509\\u0026rcl\\u003d135575602\\n#\\nwith gfile.Open('/encrypted/user\\u003d{}:scope\\u003d18100/cns/ok-d/home/piatek/encrypted_example.csv'.format(username), 'w') as f:\\nf.write('1,2\\n3,4\\n5,6\\n')\\n```\\n# Define a table to read from this file. Note the availability of autocomplete in this magic as well.\\n```python\\n%%substitute_globals\\n%%dremel_table output\\ncsv:\\nfile_names: '/encrypted/user\\u003d{username}/cns/ok-d/home/piatek/encrypted_example.csv'\\ncolumns: {\\nname: 'first_column'\\nposition: 0\\ntype: STRING\\n}\\ncolumns: {\\nname: 'second_column'\\nposition: 1\\ntype: STRING\\n}\\n```\\nUse dremel.SetDremelCredentials to forward user credentials needed to read encrypted data.\\n\\n# Set the credentials\\n```python\\ndremel.SetDremelCredentials()\\n```\\n```python\\n%%dremel_query\\nselect * from output\\n```\\nPopulating form parameters with Dremel query results\\nUse interactive_form.UpdateParam to update form widgets from Python.\\n\\nAn example using Dremel results follows.\\n\\n```python\\n%%multicell\\n%%dremel_query names\\n# Grab 10 baby names.\\nselect\\nbaby_name\\nfrom\\ndremel_codelab.babynames\\ngroup by\\nbaby_name limit 10\\n\\n%%endcell\\n```\\n```python\\n# Update the form popup with the values.\\nfrom colabtools import interactive_forms\\n\\nname \\u003d 'Names' # @param\\ninteractive_forms.UpdateParam(\\n'name', None, names.baby_name.tolist())\\n```\\nDisplay table schema using DESCRIBE\\n```python\\n%%dremel\\nDESCRIBE dremel_codelab.babynames\\n```\\nGraphing time series data\\n```python\\n%%dremel_query table\\n\\nselect\\nbaby_name, num_babies, year\\nfrom\\ndremel_codelab.babynames\\nwhere\\nstate_code \\u003d 'CA' and\\nbaby_name in ('Alice', 'Bob', 'Eric')\\ngroup by baby_name, num_babies, year\\norder by year asc\\n```\\n```python\\nimport pandas as pd\\n\\n# Set the index of the DataFrame to the year as a datetime. See:\\n# http://pandas.pydata.org/pandas-docs/stable/generated/pandas.to_datetime.html\\ntable.index \\u003d pd.to_datetime(table.year, format\\u003d'%Y', exact\\u003dTrue)\\n\\n# _ \\u003d suppresses the text summary.\\n_ \\u003d table.groupby(table.baby_name).num_babies.plot(legend\\u003dTrue)\\n```\\nStoring data in Colossus (CNS)\\nEXPORT (GoogleSQL)\\nYou can write EXPORT statements just like any other %%dremel_query.\\n\\nIf you're using EXPORT for the first time, you may need to configure an MDB group with appropriate settings.\\n\\n```python\\ndremel.SetLanguage('GoogleSQL')\\n```\\n```python\\n%%dremel\\nEXPORT DATA\\nOPTIONS (\\n# Note: You'll need to replace 'colaboratory-dremel' with your MDB group.\\npath\\u003d'/cns/ok-d/home/colaboratory-dremel/ttl\\u003d1d/materialized/babynames',\\nowner\\u003d'colaboratory-dremel',\\noverwrite\\u003dtrue)\\nAS (\\nSELECT baby_name FROM dremel_codelab.babynames GROUP BY baby_name\\n);\\n```\\nMATERIALIZE (DremelSQL)\\nYou can write MATERIALIZE statements just like any other %%dremel_query.\\n\\nIf you're using MATERIALIZE for the first time, you may need to configure an MDB group with appropriate settings.\\n\\n```python\\ndremel.SetDremelCredentials()\\ndremel.SetAccountingGroup('colaboratory-dremel')\\ndremel.SetMaterializeOwnerGroup('colaboratory-dremel')\\ndremel.SetMaterializeOverwrite(True)\\n# MATERIALIZE only works with DremelSQL.\\ndremel.SetLanguage('DremelSQL')\\n```\\n```python\\n%%dremel_query\\n\\n# Note: You'll need to replace 'colaboratory-dremel' with your MDB group.\\n# See: http://go/materialize-security\\nMATERIALIZE '/cns/ok-d/home/colaboratory-dremel/ttl\\u003d1d/materialized/babynames' AS\\nSELECT baby_name FROM dremel_codelab.babynames GROUP BY baby_name;\\n```\\nReading stored data\\nDEFINE TABLE\\nYou can use your materialized data (as well as many other data sources using DEFINE TABLE. In Colab, it's easiest to use DEFINE_TABLE using its cell magic.\\n\\nImportant considerations:\\n\\nThe data in the path below must already exist. For example, by having been written using a separate EXPORT or MATERIALIZE dremel query.\\nYou'll need to replace 'colaboratory-dremel' with your MDB group.\\n```python\\n%%dremel_table example_table\\n\\ncapacitor:/cns/ok-d/home/colaboratory-dremel/ttl\\u003d1d/materialized/babynames*\\n```\\n```python\\n%%dremel_query\\n\\nSELECT COUNT(*) as count FROM example_table\\n```\\nDremel extensions in Lua\\nYou can add custom extensions just as in the Dremel tool. For example, the lua code below prints the numbers $1$ through $n$.\\n\\n```python\\ndremel.AddExtensionModule('lua', 'genrows', '''\\n\\nlocal function GenRows(record, control)\\nfor i\\u003d1,record.n,1 do\\nout \\u003d control:makeproto()\\nout.n \\u003d i\\ncontrol:yield(out)\\nend\\nend\\n\\ngenrows_proto \\u003d [[\\nsyntax \\u003d 'proto2';\\nmessage M {\\noptional int32 n \\u003d 1;\\n}\\n]]\\n\\ngenrows_fields \\u003d {'n'}\\n\\nExportTVF('genrows', genrows_proto, GenRows, genrows_fields)\\n\\n''')\\n```\\n```python\\n%%dremel_query\\n\\nselect n from genrows(select 5 as n)\\n```\\nDefine inline Dremel macro\\n```python\\n%%dremel_define_macro mycondition\\nbaby_name \\u003d 'Jessica' AND num_babies \\u003e 1000 AND state_code \\u003d 'CA'\\n```\\n```python\\n%%dremel_query\\nSELECT num_babies, year\\nFROM dremel_codelab.babynames WHERE $mycondition\\nORDER BY year;\\n```\\nImporting Dremel macros from a file\\nWe'll start by looking at an example Dremel macros file, importing it, and then using it in a query.\\n\\nOpening Piper files requires a runtime with p4access.\\n\\nFor users: go/p4request\\nFor groups: https://g3doc.corp.google.com/devtools/piper/g3doc/public/p4_grantaccess.md?cl\\u003dhead#read_access\\n```python\\nfrom google3.pyglib import gfile\\n\\nwith gfile.Open('/google/src/head/depot/google3/experimental/colab/example/dremel/macros.sql') as f:\\nprint(f.read())\\n```\\n```python\\n%dremel_import /google_src/head/depot/google3/experimental/colab/example/dremel/macros.sql\\n```\\n```python\\n%%dremel_query\\n\\nselect\\nsum(num_babies),\\nyear,\\nbaby_name\\nfrom\\ndremel_codelab.babynames\\nwhere\\n$IsMichael(baby_name)\\ngroup by year, baby_name\\norder by year asc\\nlimit 10\\n```\\nDEFINE PERMANENT TABLE\\nReplace 'colaboratory-dremel' with your MDB group.\\nCapacitor files\\n```python\\n%%multicell\\nfrom colabtools import dremel\\n\\nimport getpass\\nusername \\u003d getpass.getuser()\\n\\n# Replace with your MDB group that has dremel-service as member.\\ndremel.SetMaterializeOwnerGroup('colaboratory-dremel')\\n\\n# Permits executing multiple times without getting an 'already exists' error.\\ndremel.SetMaterializeOverwrite(True)\\n\\n%%endcell\\n```\\n```python\\n%%dremel_query\\n\\nmaterialize '/cns/ok-d/home/colab-example/capacitor/data' AS\\nselect 1 as test_col\\n```\\n```python\\nfrom google3.analysis.common.pandas import capacitor\\ncapacitor.Read('/cns/ok-d/home/colab-example/capacitor/data*')\\n```\\n```python\\n%%substitute_globals\\n%%plx_query\\ndefine permanent table {username}.capacitortest '/cns/ok-d/home/colab-example/capacitor/data*'\\n```\\n```python\\n%%substitute_globals\\n%%dremel_query\\nselect * from {username}.capacitortest\\n```\\nCSV\\n```python\\n%%multicell\\nfrom colabtools import dremel\\n\\nimport getpass\\nusername \\u003d getpass.getuser()\\n\\ndremel.SetMaterializeOwnerGroup('colaboratory-dremel')\\ndremel.SetMaterializeOverwrite(True)\\n\\n%%endcell\\n```\\n```python\\n%%dremel_query\\n\\nmaterialize 'csv:/cns/ok-d/home/colab-example/csv/test.csv header:true' AS\\nselect 100 as test_col\\n```\\n```python\\nfrom google3.pyglib import gfile\\n# Inspect the CSV files.\\nwith gfile.Open('/cns/ok-d/home/colab-example/csv/test.csv-00000-of-00001', 'r') as f:\\nprint(f.read())\\n```\\n```python\\n%%substitute_globals\\n%%plx_query\\ndefine permanent table {username}.csvtest 'csv:/cns/ok-d/home/colab-example/csv/test.csv*'\\n```\\n```python\\n%%substitute_globals\\n%%dremel_query\\nselect * from {username}.csvtest\\n```\\nUsing WITH statements in DremelSQL\\n```python\\nfrom colabtools import dremel\\ndremel.SetLanguage('GoogleSQL')\\n```\\n```python\\n%%dremel_query\\n\\nWITH alias AS (SELECT 'alias' as v) SELECT v FROM alias\\n```\\nChaining Dremel queries with substitution\\nThe example below shows how to use the results of one Dremel query in subsequent queries.\\n\\n```python\\n%%multicell\\n%%dremel_query result\\n\\nselect 'the first' as value\\n\\n%%endcell\\n```\\n```python\\nprint('result is a {}'.format(type(result)))\\nvalue \\u003d result.value\\nprint('value is {}'.format(value))\\n\\n%%endcell\\n```\\n```python\\n%%substitute_globals\\n%%dremel_query\\n\\nselect '{value}' as reused\\n```\\nPreserving NULL values in Dremel queries\\nBy default, NULL values will be presented as zeros. To maintain NULL values, set dremel.PRESERVE_NULL.\\n\\n```python\\nfrom colabtools import dremel\\n\\ndremel.PRESERVE_NULL \\u003d True\\ndremel.SetLanguage('DremelSQL')\\n```\\n```python\\n%%dremel_query\\n\\n# A query where first(a) will return NULL. In the results, NULL values are\\n# displayed as NaNs.\\nselect\\nfirst(a)\\nfrom (\\nselect 1 as a\\n) where a!\\u003d 1\\n```\\nDEFINE SCHEMA FOR... to accelerate Dremel queries\\nDEFINE SCHEMA FOR... allows you to manually express the schema of a table to Dremel service. This can significantly increase the performance of queries over tables with complex schemas, e.g., gwslogs using GWSLogProtoEntry.\\n\\nReplace 'colaboratory-dremel' with your MDB group.\\n```python\\nfrom colabtools import dremel\\n\\ndremel.SetDremelCredentials()\\ndremel.SetAccountingGroup('colaboratory-dremel')\\ndremel.SetMaterializeOwnerGroup('colaboratory-dremel')\\ndremel.SetMaterializeOverwrite(True)\\n```\\n```python\\n%%dremel_query\\n\\n# We'll only use UserAgent in our query below, so we materialize a restricted\\n# schema with this field only.\\nMATERIALIZE '/cns/ok-d/home/colaboratory-dremel/dremel/example/defineschema' AS\\nSELECT g\\nUserAgent\\nFROM\\ngfstmp_corp_colaboratory_weblog.tmp_colaboratory.yesterday\\nLIMIT 0;\\n```\\n```python\\n%%dremel_table filtered\\ncfs-columnio: /cns/ok-d/home/colaboratory-dremel/dremel/example/defineschema*\\n```\\n```python\\n%%dremel\\ndefine schema for gfstmp_corp_colaboratory_weblog.tmp_colaboratory.yesterday from table filtered;\\n```\\n```python\\n%%dremel_query\\n# Count the number of distinct UserAgent strings for Colab users yesterday\\n# using the newly defined schema.\\nselect\\ncount(distinct UserAgent)\\nfrom\\ngfstmp_corp_colaboratory_weblog.tmp_colaboratory.yesterday\\n```\\nSHOW TABLES to search tables\\n```python\\n%%dremel\\n\\nshow tables like '%codelab%';\\n\\n-- Or, equivalently:\\nshow tables where table_name contains 'codelab';\\n```\\n\\n\\n\\nGoogle Drive\\n\\nLoad this as a notebook in Colab\\n\\nRead a spreadsheet using robot credentials\\nIt's often important to be able to read or write data from Google Sheets in an offline process, such as a dashboard or borgcron job. In order to do this, we use robot credentials, which in most cases can be configured via http://robotmanager/.\\n\\nNote that the robot is itself a separate entity, so must have access to any spreadsheets. Spreadsheets created by your robot will not appear in your Drive listing.\\n\\nAdditionally, if your robot does not have an associated project, you'll hit quota issues. In this case, you can simply add an API key (or use the colab API key, as below) to avoid these issues.\\n\\n```python\\nfrom colabtools import auth, sheets\\n\\n# Create robot credentials for the robot associated with this user.\\nrobot_email \\u003d auth.get_robot_email()\\ncreds \\u003d auth.get_robot_credentials(robot_email, scopes\\u003dsheets.SCOPES)\\n\\n# Initialize the Sheets client with our credentials and key (which will also\\n# initialize the Drive client).\\nsheets.set_credentials(creds)\\n\\n# Now we can do Drive and Sheets operations on behalf of our robot.\\nsheets.get_spreadsheets()\\n```\\n# @title Error: `the request is missing a valid API key`\\n\\n# If you see errors about missing API keys you can either\\n# 1) create a GCP project and generate an API key, or\\n# 2) use auth.COLAB_API_KEY that shares its quota with many users\\n# go/colab/robots has more info\\n\\n```python\\nsheets.set_credentials(creds, api_key\\u003dauth.COLAB_API_KEY)\\nsheets.get_spreadsheets()\\n```\\nCreate a new Spreadsheet\\nCreates a new Google Drive spreadsheet.\\n\\n```python\\nfrom colabtools import sheets\\n\\nspreadsheet_title \\u003d 'Sample Spreadsheet'\\n\\nsheet_id \\u003d sheets.create_spreadsheet(spreadsheet_title)\\n\\nsheet_id\\n```\\nOpen or create a spreadsheet\\nOpen a spreadsheet selected by title, or create the spreadsheet if none can be found.\\n\\n```python\\nfrom colabtools import sheets\\n\\nspreadsheet_title \\u003d 'Sample Spreadsheet' # @param {type: 'string'}\\n\\nsheet_id \\u003d None\\n\\nfound_sheets \\u003d sheets.get_spreadsheets(title_regex\\u003dspreadsheet_title).data\\nif found_sheets.size:\\nsheet_id \\u003d found_sheets\\nelse:\\nsheet_id \\u003d sheets.create_spreadsheet(spreadsheet_title)\\n\\nsheet_id\\n```\\nEmbed a link to a spreadsheet\\n```python\\nfrom colabtools import publish\\n\\nsheet_id \\u003d '1uIXhcW_FrxFYfjRXMhmTRt1dr9H8_KyZmygJdRRznbI'\\n\\npublish.html('''\\n\\u003ca target\\u003d'_blank' href\\u003d'https://docs.google.com/spreadsheets/d/%s/edit'\\u003e\\nExample sheet\\n\\u003c/a\\u003e\\n''' % sheet_id)\\n```\\nFind a spreadsheet by title\\n```python\\nfrom colabtools import sheets\\n\\nspreadsheet_title \\u003d 'Sample Spreadsheet'\\n\\nsheet_id \\u003d sheets.get_spreadsheets(title_regex\\u003dspreadsheet_title).data\\n```\\nFind a worksheet in a spreadsheet by title\\nOpen a worksheet by title, or create the worksheet if none can be found.\\n\\n```python\\nfrom colabtools import sheets\\n\\nsheet_id \\u003d '1uIXhcW_FrxFYfjRXMhmTRt1dr9H8_KyZmygJdRRznbI' # @param {type: 'string'}\\nworksheet_name \\u003d 'Sheet1' # @param {type: 'string'}\\n\\nworksheets \\u003d sheets.get_worksheets(sheet_id)\\nmatching_worksheets \\u003d worksheets[worksheets['Title'] \\u003d\\u003d worksheet_name]\\nif matching_worksheets.size:\\nworksheet_id \\u003d matching_worksheets['Worksheet Id'].iloc\\nelse:\\nworksheet_id \\u003d sheets.add_worksheet(sheet_id, worksheet_name)\\nworksheet_id\\n```\\nRead data from a sheets URL into a dataframe\\nRead the contents of a spreadsheet worksheet into a Pandas DataFrame.\\n\\n```python\\nfrom colabtools import sheets\\n\\nurl \\u003d 'https://docs.google.com/spreadsheets/d/1DJDsHq1xhw-3dqalsiga7g1EChpVcmDOJrSxWflxL_4/edit#gid\\u003d916555165'\\n\\ndf \\u003d sheets.get_cells(\\nspreadsheet_id\\u003dsheets.get_spreadsheet_id(url),\\nworksheet_id\\u003dsheets.get_worksheet_id(url))\\ndf\\n```\\nRead spreadsheet cell values without formatting\\nWhen reading from a spreadsheet worksheet that has formatting, one might get values like '24.5%' when one wants to get 0.245. It is possible to ask for values without formatting.\\n\\n```python\\nfrom colabtools import sheets\\n\\nsheet_id \\u003d '1DJDsHq1xhw-3dqalsiga7g1EChpVcmDOJrSxWflxL_4'\\n\\n# The first worksheet\\nworksheet_id \\u003d sheets.get_worksheets(sheet_id)['Worksheet Id'].values\\n\\n# Returns data without formatting and with first row interpreted as column names.\\nsheets.get_cells(\\nsheet_id,\\nworksheet_id,\\nhas_col_header\\u003dTrue,\\nvalue_render_option\\u003dsheets.ValueRenderOption.UNFORMATTED_VALUE)\\n```\\nExport data to a spreadsheet\\nWrites the contents of a DataFrame to a Google Drive spreadsheet.\\n\\n```python\\nfrom colabtools import sheets\\nimport pandas as pd\\n\\nsheet_id \\u003d '1uIXhcW_FrxFYfjRXMhmTRt1dr9H8_KyZmygJdRRznbI'\\n\\ndata \\u003d {'Year':,\\n'Top Animal': ['Giant panda', 'Chicken', 'Pig', 'Turkey', 'Dog']}\\n# Use columns argument to specify the order\\ndf \\u003d pd.DataFrame(data, columns\\u003d['Year', 'Top Animal'])\\n\\n# The first worksheet\\nworksheet_id \\u003d sheets.get_worksheets(sheet_id)['Worksheet Id'].values\\n\\nsheets.update_cells(sheet_id, worksheet_id, df, include_col_header \\u003d True)\\n```\\n\\n\\n\\nEvergreen\\n\\nLoad this as a notebook in Colab\\n\\nEvergreen Model Selection, Client Setup and Basic Generation\\nFor more information on how to use Evergreen in colab, please visit go/evergreen-colab.\\n\\nThe AI Platform model client provides access to various GDM models via a single, simple sampling interface.\\n\\nSee the API documentation for the full list of supported functionality, and the tool controller demo for a demo of using these models to call tools.\\n\\nFor support, please reach out to go/ai-platform-users on gChat.\\n\\n```python\\nfrom google3.learning.deepmind.evergreen.model_access.client.python import model_client\\nfrom IPython import display\\n\\nmodels \\u003d {}\\nfor model_entry in model_client.ModelEntry:\\nmodels[model_entry.name] \\u003d model_entry.value\\n\\nimport ipywidgets as widgets\\nmodel_picker \\u003d widgets.Dropdown(options\\u003dmodels.keys(), value\\u003d'GEMINI_S_FLASH')\\ndef model_url():\\nreturn models[model_picker.value]\\nmodel_picker.model_url \\u003d model_url\\n\\nprint('select your model')\\nmodel_picker\\n```\\n## Create an Evergreen client with the selected model\\n\\n```python\\nclient \\u003d model_client.ModelClient(\\nmodel_url\\u003dmodel_picker.model_url(),\\ndefault_config\\u003dmodel_client.make_generation_config(\\nseed\\u003d0,\\ntoken_generation\\u003dmodel_client.make_token_generation_config(\\nsampling_config\\u003dmodel_client.make_sampling_config(\\ntemperature\\u003d1,\\nnucleus_top_p\\u003d0.95,\\n),\\nlength\\u003d8192,\\n),\\n),\\n)\\n```\\nThe simplest way to use the client is for plain text-to-text sampling. You can decode the outputs with the as_text helper, or display them directly in Colab.\\n\\nYou can call generate on the client to get the response in a single combined output\\n\\n```python\\nresponse \\u003d client.generate('Describe chocolate in 5 words')\\nformatted_prompt \\u003d response.substreams['prompt']\\ndisplay.display(response)\\n```\\nOr you can call generate_stream to receive the output in a stream of chunks as they become available.\\n\\nNote that for IT models like GEMINI_M_IT, requests will be formatted automatically by default. We can retrieve the formatted prompt by printing the contents of the 'prompt' substream. If you want to learn more about automatic formatting, see more details on go/evergreen-api-formatting-colab\\n\\n```python\\nfor content in client.generate_stream(\\n'If you could describe chocolate in 5 words, what would they be?',\\n):\\nprint(model_client.as_text(content), end\\u003d'')\\n```\\nEvergreen multimodal content\\nMultimodal input\\nTo condition generation on text and images, we can use Gemini. The variant used here is both multimodal and instruction tuned, so we specify the prompt in the form of a question.\\n\\n```python\\nfrom google3.learning.deepmind.evergreen.model_access.client.python import model_client\\n\\ngemini_mm_client \\u003d model_client.ModelClient(\\nmodel_url\\u003dmodel_client.ModelEntry.GEMINI_M_MMITV,\\ndefault_config\\u003dmodel_client.make_generation_config(\\nnucleus_top_p\\u003d0.8,\\n),\\n)\\n```\\nYou can specify multimodal content directly as an interleaved sequence of text and media.\\n\\nHere we pass a PIL.Image in the prompt.\\n\\n```python\\nfrom google3.pyglib import gfile\\nfrom IPython import display\\nimport PIL.Image\\n\\npath \\u003d '/cns/el-d/home/evergreen/demos/model_access/red_flower.jpg'\\nimage_pil \\u003d PIL.Image.open(gfile.Open(path, 'rb'))\\ndisplay.display(image_pil)\\n\\ngemini_mm_client.generate([image_pil, 'What is in this picture?'])\\n```\\nMultimodal output\\nWe can generate images using Miro. Note that this particular model server is unreliable so the request may fail occasionally.\\n\\n```python\\nmiro_client \\u003d model_client.ModelClient(model_client.ModelEntry.MIRO_V4)\\nresponse \\u003d miro_client.generate('A penguin in a tuxedo')\\n# The `Content` class can be displayed with IPython.display directly.\\n# This will work for multimodal content on a best-effort basis.\\ndisplay.display(response)\\n```\\nWe can also stream back images of increasing resolution using generate_stream.\\n\\n```python\\nresponse \\u003d model_client.Content()\\nfor chunk in miro_client.generate_stream('A penguin in a tuxedo'):\\nresponse +\\u003d chunk\\ndisplay.clear_output()\\ndisplay.display(response)\\n```\\n\\n\\n\\nF1 queries\\n\\nLoad this as a notebook in Colab\\n\\nF1 SQL\\ngo/f1sql\\nF1 Query Resource Accounting\\nAn accounting group allows you to issue queries beyond the daily freebie quota. See go/f1-query-resource-accounting.\\n\\n```python\\nfrom colabtools import f1\\n\\nf1.set_accounting_group('\\u003cmdb group\\u003e')\\n```\\nF1 Instance\\nYou can change the F1 instance you would like to query via f1_instance.\\n\\n```python\\nfrom colabtools import f1\\n\\n# Set the F1 instance to '/f1/query/prod'\\nf1.ConnectToF1(f1.QUERY_F1)\\n```\\nRead data from F1 into a dataframe\\nThe colabtools f1 client library provides a convenient method to query data using F1 and store the result in a Pandas DataFrame.\\n\\n```python\\nfrom colabtools import f1\\n\\ndf \\u003d f1.Execute('''\\nSELECT\\nbaby_name,\\nsum(num_babies) AS count\\nFROM f1_codelab.babynamesUS\\nGROUP BY baby_name\\nORDER BY count DESC\\nLIMIT 10\\n''')\\ndf\\n```\\nQuery data with F1\\n```python\\nfrom colabtools import f1\\n\\nresult \\u003d f1.Execute('''\\nSELECT\\nbaby_name,\\nsum(num_babies) AS count\\nFROM f1_codelab.babynamesUS\\nGROUP BY baby_name\\nORDER BY count DESC\\nLIMIT 10\\n''')\\n\\n# result is a Pandas DataFrame with the results of the query.\\nresult\\n```\\nEnable the data_table display for interactive viewing of the resulting Pandas DataFrame.\\n\\n```python\\nfrom google.colab import data_table\\n\\ndata_table.enable_dataframe_formatter()\\nresult\\n```\\nQuerying using cell magics\\nAlternatively F1 queries can be executed with the python F1 cell magic, %%f1. Cell magics are more compact, but can be more difficult to integrate with other python code or to move into non-Colab library code.\\n\\n```python\\n%%f1\\nSELECT\\nbaby_name,\\nsum(num_babies) AS count\\nFROM f1_codelab.babynamesUS\\nGROUP BY baby_name\\nORDER BY count DESC\\nLIMIT 10\\n```\\nSave F1 results to CSV or Sheets\\nThe result of an F1 query is a Pandas DataFrame, which can be saved to Sheets or a CSV file.\\n\\nSaving a DataFrame to sheets\\n\\nTo save as CSV, use the to_csv function.\\n\\n```python\\nfrom colabtools import f1\\n# Save the top 10 baby names to the Python variable 'results'.\\nresults \\u003d f1.Execute('''\\nSELECT\\nbaby_name,\\nsum(num_babies) AS count\\nFROM f1_codelab.babynamesUS\\nGROUP BY baby_name\\nORDER BY count DESC\\nLIMIT 10\\n''')\\n\\n# Save the results to the file '/tmp/babynames.csv'\\nwith open('/tmp/babynames.csv', 'w') as f:\\nresults.to_csv(f)\\n\\n# The results can be read from the file using pandas.read_csv()\\nimport pandas as pd\\npd.read_csv('/tmp/babynames.csv')\\n```\\nLoad SQL modules - client methods\\nYou can easily load SQL modules with either import_modules_from_path (either from Google3 HEAD by default, or any other SrcFS location like '/google_src/cloud/username/citc_client/google3') or import_modules_from_mpm (which supports generated dependencies).\\n\\nDon't forget to also:\\n\\nClear up any module data before reloading if you had already loaded some modules, using f1.clear_all_sql_module_state().\\nSpecify the necessary UDF server(s) if the modules require some, using f1.add_udf_server(udf_server_address).\\n```python\\nfrom colabtools import f1\\nmodules \\u003d [\\n('math_utils', 'sql.modules.math_utils'),\\n('string_utils', 'sql.modules.string_utils')]\\n# Load modules from Google3 HEAD:\\nf1.clear_all_sql_module_state()\\nf1.import_modules_from_path(modules)\\nf1.Execute('''\\n# Query using the modules loaded above.\\nSELECT\\nmath_utils.FloorDiv(-3, 2) AS division_result,\\nstring_utils.RemovePrefix('fails or works', 'fails or ') AS status\\n''')\\n```\\nLoad SQL modules - SQL statements\\nYou can also load SQL modules and set the import path via SQL statements. This method is more flexible because it allows for changing the module sourcing path in between module sourcing statements whereas the top-level client methods require a single import invocation with a fixed source path.\\n\\n```python\\nf1.Execute('''\\nSET QueryRequest.global_import_path \\u003d '/google_src/head/depot/google3';\\n\\nIMPORT MODULE sql.modules.math_utils;\\nIMPORT MODULE sql.modules.string_utils;\\n\\nSELECT\\nmath_utils.FloorDiv(-3, 2) AS division_result,\\nstring_utils.RemovePrefix('fails or works', 'fails or ') AS status\\n''')\\n```\\nLoad proto from the globaldb\\nF1 allows clients to directly reference types from the global proto DB.\\n\\n```python\\nfrom colabtools import f1\\nf1.Execute('''\\nWITH T AS (\\nSELECT 'Timothy Meyer' AS displayname\\nUNION ALL SELECT 'Alice Bob'\\nUNION ALL SELECT 'Lawyercat'\\n)\\nSELECT\\nperson.displayname,\\nFROM\\n(\\nSELECT new global_proto_db.`photos.Person`(displayname) AS person FROM T\\n);\\n''')\\n```\\nWhere photos.Person is the proto defined here, which can also be instantiated using the colabtools.proto library, i.e.\\n\\n```python\\nfrom colabtools import proto\\np \\u003d proto.LookupMessage('photos.Person')\\n```\\nAlternatively the same code can be written as a more condensed cell magic. Cell magics are more compact, but can be more difficult to integrate with other python code or to move into non-Colab library code.\\n\\n```python\\n%%f1\\nWITH T AS (\\nSELECT 'Timothy Meyer' AS displayname\\nUNION ALL SELECT 'Alice Bob'\\nUNION ALL SELECT 'Lawyercat'\\n)\\nSELECT\\nperson.displayname,\\nFROM\\n(\\nSELECT new global_proto_db.`photos.Person`(displayname) AS person FROM T\\n);\\n```\\nF1 Graphing time series data\\n```python\\nfrom colabtools import f1\\n\\ndf \\u003d f1.Execute('''\\nSELECT\\nbaby_name, num_babies, year\\nFROM\\nf1_codelab.babynamesUS\\nWHERE\\nstate_code \\u003d 'CA' and\\nbaby_name in ('Bob', 'Alice', 'Eric')\\nGROUP BY baby_name, num_babies, year\\nORDER BY year ASC\\n''')\\n```\\n```python\\nimport pandas as pd\\n\\n# Set the index of the DataFrame to the year as a datetime. See:\\n# http://pandas.pydata.org/pandas-docs/stable/generated/pandas.to_datetime.html\\ndf.index \\u003d pd.to_datetime(df.year, format\\u003d'%Y', exact\\u003dTrue)\\n\\n# _ \\u003d suppresses the text summary.\\n_ \\u003d df.groupby(df.baby_name).num_babies.plot(legend\\u003dTrue)\\n```\\nChaining F1 queries with substitution\\nThe example below shows how to use the results of one F1 query in subsequent queries using the f1 pywrap_client.SqlBuilder.\\n\\n```python\\nfrom colabtools import f1\\nfrom google3.storage.f1.client import pywrap_client\\n\\ndf \\u003d f1.Execute('''\\nSELECT\\n'the first' AS name,\\n123 AS number\\n''')\\n\\nprint('df is a {}'.format(type(df)))\\nprint('name \\u003d {}'.format(df.name))\\nprint('number \\u003d {}'.format(df.number))\\n\\nquery_builder \\u003d pywrap_client.SqlBuilder('''\\nselect\\n@param_str as reused_string,\\n@param_int as reused_int\\n''')\\nquery_builder.AddString('param_str', df.name)\\nquery_builder.AddInt32('param_int', int(df.number))\\n\\nf1.ExecuteQuery(query_builder)\\n```\\nExecute F1 queries programmatically\\nF1 sql queries can be executed programmatically using the colabtools f1.Execute method.\\n\\n```python\\nfrom IPython.display import display\\nfrom colabtools import f1\\n\\nfor i in range(10):\\ndisplay(f1.Execute(f'SELECT {i} AS foo'))\\n```\\nF1 SHOW TABLES to search tables\\n```python\\n%%f1\\n\\nSHOW tables\\n```\\nF1 DESCRIBE to see the schema for a table\\n```python\\n%%f1\\n\\nDESCRIBE F1ApplicationInfo\\n```\\n\\n\\n\\nInput Output Reading Writing IO\\n\\nLoad this as a notebook in Colab\\n\\nWrite a dataframe to a CSV on CNS\\n```python\\nimport pandas as pd\\nfrom google3.pyglib import gfile\\n\\ndf \\u003d pd.DataFrame({\\n'Year':,\\n'Top Animal': ['Giant panda', 'Chicken', 'Pig', 'Turkey', 'Dog']\\n})\\n\\n# Ensure all parent directories exist\\ngfile.MakeDirs('/cns/sandbox/home/USERNAME/colab-demo')\\nwith gfile.Open('/cns/sandbox/home/USERNAME/colab-demo/dataframe.csv', mode\\u003d'w') as f:\\ndf.to_csv(f)\\n```\\nRead data from a CSV in CNS into a dataframe\\n```python\\nfrom google3.pyglib import gfile\\nimport pandas as pd\\n\\nwith gfile.Open('/cns/sandbox/home/USERNAME/colab-demo/dataframe.csv', mode\\u003d'r') as f:\\ndf \\u003d pd.read_csv(f)\\n\\ndf\\n```\\nWrite a dataframe to a capacitor file on CNS\\n```python\\nimport pandas as pd\\nfrom google3.analysis.common.pandas import capacitor\\n\\ndf \\u003d pd.DataFrame({\\n'Year':,\\n'Top Animal': ['Giant panda', 'Chicken', 'Pig', 'Turkey', 'Dog']\\n})\\n\\ncapacitor.Write(df, '/cns/sandbox/home/USERNAME/colab-demo/capacitor_dataframe')\\n```\\nRead data from capacitor files in CNS into a dataframe\\n```python\\nfrom google3.analysis.common.pandas import capacitor\\n\\ndf \\u003d capacitor.Read('/cns/sandbox/home/USERNAME/colab-demo/capacitor_dataframe')\\n\\ndf\\n```\\nUse Dremel to query capacitor data on CNS\\n```python\\nfrom google3.research.colab.lib import dremel\\n\\ndremel.dremel_table('stored_data', 'capacitor:/cns/sandbox/home/USERNAME/colab-demo/capacitor_dataframe')\\n```\\n```python\\n%%dremel_query\\n\\nSELECT * FROM stored_data\\n```\\nEmbed a file in notebook to provide a download link\\nFiles can be embedded in the Colab notebook to provide download access at later times.\\n\\nNote that the contents of the file will be added to the notebook will increase the file size.\\n\\nSee http://go/colab-document-size-limit.\\n\\n```python\\nimport pandas as pd\\nfrom google3.pyglib import gfile\\n\\ndf \\u003d pd.DataFrame({\\n'Year':,\\n'Top Animal': ['Giant panda', 'Chicken', 'Pig', 'Turkey', 'Dog']\\n})\\n\\nwith gfile.Open('/tmp/file.txt', mode\\u003d'w') as f:\\ndf.to_csv(f)\\n\\n\\n# Note that the contents of the file will be added to the notebook will increase\\n# the file size. See http://go/colab-document-size-limit.\\n%download_file /tmp/file.txt\\n```\\nAlternatively the file can be copied to x20 then downloaded from there.\\n\\n```bash!fileutil cp -f /cns/pa-d/home/blois/colab-demo/dataframe.csv /x20/users/bl/blois/data/dataframe.csv\\n```\\n\\n\\n\\nJavascript\\n\\nLoad this as a notebook in Colab\\n\\nJavascript from Python\\n```python\\nfrom colabtools import js\\njsGlobal \\u003d js.JsGlobal\\n\\ndiv \\u003d jsGlobal.document.createElement('div')\\ndiv.innerHTML \\u003d 'abc123'\\n# The '_ \\u003d...' syntax suppresses the output log of the Javascript assignment.\\n_ \\u003d jsGlobal.document.body.appendChild(div)\\n```\\nPeriodic cell reexecution\\n```python\\nexecuted \\u003d 0\\nimport time\\nfrom colabtools import js\\n\\nexecuted +\\u003d 1\\n\\nprint('Current time is: ', time.time())\\n\\nif executed \\u003c 3:\\njs.JsGlobal.setTimeout(js.JsGlobal.executeCell, 2000)\\nelse:\\nprint('Executed 3 times; stopping.')\\n```\\nMessaging: Communicating between cells\\n```javascript\\nregisterListener('listener_key', (message, payload) \\u003d\\u003e {\\n$('#output-body').append(`Received ${message} with value ${payload.value}`)\\n})\\n```\\n```javascript\\ncolab.sendMessageToListeners('listener_key', {'value': '123'})\\n```\\nMessaging: Python to Javascript\\n```javascript\\nregisterListener('listener_key', (message, payload) \\u003d\\u003e {\\n$('#output-body').append(`Received ${message} with value ${payload.value}`)\\n})\\n```\\n```python\\nfrom colabtools import js\\n_ \\u003d js.JsGlobal.colab.sendMessageToListeners('listener_key', {'value': 123})\\n```\\nMessaging: Javascript to Python\\n```python\\nfrom colabtools import message\\n\\ndef listener(tag_id, data, info):\\nprint('Listener received', data['value'])\\n\\n\\nmessage.Subscribe('python_listener', listener, True)\\n```\\n```javascript\\ncolabtools.sendMessageToKernel('python_listener', {'value': 123})\\n```\\n\\n\\n\\nMagics Colab Magics\\n\\nLoad this as a notebook in Colab\\n\\n```python\\nfrom colabtools import dremel\\ndremel.SetIOTimeout(600)\\n```\\n```python\\n%%dremel_query magic\\nExecutes the dremel query provided and displays the results as an interactive table.\\n\\nReferences: * Colab magics\\n\\n%%dremel_query\\n\\nSELECT * FROM\\ndremel_codelab.babynames\\nWHERE\\nstate_code \\u003d 'CA'\\nLIMIT 100\\n```\\n```python\\n%dremel_query line magic\\nColab (and IPython) have two kinds of magics: line magics (invoked with %) and cell magics (invoked with %%). The primary difference is in how much input gets passed to them: line magics get the rest of the line where they appear, and are intended to be mixed in with Python code. Cell magics consume the entire cell where they appear, and must appear as the first (non-comment) line in a cell. Some other small differences:\\n\\nLine magics return a value, but cell magics don't.\\nLine magics support {} for inserting python values (see the example below).\\nCell magics also support arguments, which appear on the same line as the magic command itself.\\nReferences: * Colab magics\\n\\n# Use dremel_query as a line magic:\\nresults \\u003d %dremel_query SELECT * FROM dremel_codelab.babynames LIMIT 5\\n\\n# Alternatively:\\nselect \\u003d ('SELECT {cols}, SUM(num_babies) AS total FROM dremel_codelab.babynames '\\n'GROUP BY {cols} ORDER BY total DESC'.format(\\ncols\\u003d', '.join(('baby_name', 'year'))))\\nresults \\u003d %dremel_query {select}\\nresults.head(5)\\n```\\nAssign the results of a %%dremel_query to a Python variable\\nThe results of a Dremel query can be assigned to a Python variable as a Pandas Dataframe object.\\n\\nReferences: * Colab magics\\n\\nQuery the table and assign the results to table_data:\\n\\n```python\\n%%dremel_query table_data\\nSELECT baby_name, year, SUM(num_babies) as total\\nFROM\\ndremel_codelab.babynames\\nWHERE\\nbaby_name \\u003d 'Craig'\\nGROUP BY 1, 2\\n```\\nUse the results of the Dremel query in Python:\\n\\n```python\\n# Python code using the table_data Dataframe object.\\nfrom IPython.display import display\\nfrom colabtools import interactive_table\\n\\ntable_data.sort_values('total', ascending\\u003dFalse).head(n\\u003d10)\\n```\\n```bash\\n%%shell magic\\nThe %%shell magic allows executing bash shell code, where you can run executables or anything else you might want.\\n\\nReferences: * Colab magics\\n\\n%%shell\\n\\ncat /proc/cpuinfo |\\u0026 head -10\\n```\\nAssign output of %%shell magic to a Python variable\\nReferences: * Colab magics\\n\\nAssign the results of the shell command to shell_output:\\n\\n```bash\\n%%shell --out\\u003dshell_output --skip_output\\n# Shell code\\ncat /proc/meminfo | grep MemTotal\\n```\\nUse the results of the shell command in Python:\\n\\n```python\\nprint(shell_output)\\n```\\n```html\\n%%html magic\\nHTML can be published to the output of the cell using the %%html magic.\\n\\nReferences: * Colab magics\\n\\n%%html\\n\\u003cmarquee\\u003e\\n\\u003cdiv style\\u003d'font-size: 36px; opacity: 0.5;'\\u003eHTML content\\u003c/div\\u003e\\n\\u003c/marquee\\u003e\\n\\n\\u003cp\\u003eSVG content:\\u003c/p\\u003e\\n\\u003csvg xmlns\\u003d'http://www.w3.org/2000/svg' viewBox\\u003d'0 0 450 400' width\\u003d'200' height\\u003d'200'\\u003e\\n\\u003crect x\\u003d'80' y\\u003d'0' width\\u003d'250' height\\u003d'250' rx\\u003d'20' style\\u003d'fill:red; stroke:black; fill-opacity:0.7' /\\u003e\\n\\u003crect x\\u003d'180' y\\u003d'50' width\\u003d'250' height\\u003d'250' rx\\u003d'40' style\\u003d'fill:blue; stroke:black; fill-opacity:0.5;' /\\u003e\\n\\u003c/svg\\u003e\\n```\\n```python\\n%%substitute_globals magic\\nUse %%substitute_globals to reference Python variables in subsequent cells.\\n\\nReferences: * Colab magics\\n\\nmy_python_value \\u003d 'abc123'\\n```\\n```html\\n%%substitute_globals\\n%%html\\n\\n\\u003cdiv\\u003ePython value is {my_python_value}\\u003c/div\\u003e\\n```\\n```python\\nUse %%substitute_globals to reference the python variable from a %%dremel_query\\nReferences: * Colab magics\\n\\nyear \\u003d 1980\\n```\\n```python\\n%%substitute_globals\\n%%dremel_query\\nSELECT baby_name, SUM(num_babies) as cnt from dremel_codelab.babynames where year \\u003d {year} GROUP BY baby_name ORDER BY cnt DESC LIMIT 5;\\n```\\n```python\\n%%multicell magic\\nMulticell gives you the ability to combine magics, like having Python, CSS, Javascript, and HTML all in the same place.\\n\\nReferences: * Colab magics\\n\\n%%multicell\\n\\nprint('This is python')\\n\\n%%endcell\\n%%javascript\\n\\nvar div \\u003d document.createElement('div');\\ndiv.textContent \\u003d 'This is Javascript';\\ndocument.body.appendChild(div);\\n\\n%%endcell\\n```\\n```javascript\\n%%javascript magic\\nJavascript allows executing Javascript code as part of the code cell.\\n\\nReferences: * Colab magics\\n\\n%%javascript\\n\\nvar div \\u003d document.createElement('div');\\ndiv.textContent \\u003d 'This is Javascript';\\ndocument.body.appendChild(div);\\n```\\n```python\\n%max_output_height magic\\nThe maximum cell output height can be specified for long output.\\n\\nAlso see the %output_height magic.\\n\\nReferences: * Colab magics\\n\\n%max_output_height 100\\n\\nfor i in range(100):\\nprint(i)\\n```\\n```python\\n%output_height magic\\nThe maximum cell output height can be specified for long output.\\n\\nAlso see the %max_output_height magic.\\n\\nReferences: * Colab magics\\n\\n# Set the cell output to 500px\\n%output_height 100\\n```\\n```python\\n%%parse_proto magic\\nProtos can be parsed and manipulated with the %%parse_proto magic. Note that this includes context-aware autocomplete: trigger with ctrl-space (or cmd-space on OSX).\\n\\nReferences: * Colab magics\\n\\n%%parse_proto GenericSearchRequest search_request\\nquery: 'q\\u003dcolab magics'\\nnum: 100\\n```\\n\\n\\n\\n```python\\nfrom xmanager import resource_selector as rs\\nfrom xmanager import xm\\nfrom xmanager import xm_abc\\n```\\n\\nNon DeepMind users need to specify what resource pool and allocation to use. See the resource allocations you have access to [here](https://www.google.com/url?sa\\u003dE\\u0026source\\u003dgmail\\u0026q\\u003dhttps://xm2a.corp.google.com/resources/users/{{USERNAME}}).\\n\\n```python\\n# @markdown Non DeepMind users need to specify resource allocation, such as 'group:pilot/dmgi-xmanager-pilot-users'.\\n\\nxm_resource_alloc \\u003d ''  # @param {type:'string'}\\n\\nif xm_resource_alloc:\\nxm_abc.set_xmanager_flags(xm_resource_alloc)\\n```\\nOpen-sourced code would import `xm_local` instead of `xm_abc`. It provides the same API, but does not use XManager service and launches binaries directly. It doesn't support running on Borg.\\n\\n```python\\nfrom xmanager import xm_local\\n```\\nNew API is **eager**. Remember TF vs JAX? Experiments are now constructed interactively, which leads to greater flexibility and interoperability.\\n\\nLet's create one...\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Hello XM API', attribution_urls\\u003d['rh/efforts/1910']\\n) as experiment:\\n# We've just created a new experiment. It is empty but it exists, so...\\nprint(f'I can use XID\\u003d{experiment.experiment_id} to construct arguments')\\n\\nraise Exception('I don't know what to do next.')\\n```\\nThe experiment above exists in XManager UI, but because launch script has failed (raised an exception) it would be automatically hidden. Let's create something more useful. Broadly speaking, launching experiment consists of following steps:\\n\\n* [x] Creating the experiment\\n* Populating metadata (tags, notes)\\n* Packaging: building executables we want to launch\\n* Execution: describing how to launch these executables\\n\\n\\nLet's run an end-to-end example before diving into details.\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Simple single binary example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n# Metadata.\\nannotations \\u003d experiment.context.annotations\\nannotations.add_tags('demo')\\n\\n# Packaging.\\n[executable] \\u003d experiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/executables:echo_fragmented_mpms',\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n),\\n])\\n\\n# Execution.\\nexperiment.add(\\nxm.Job(\\nexecutable,\\nargs\\u003d{\\n'learning_rate': 0.01,\\n'batch_size': 32,\\n},\\nexecutor\\u003dxm_abc.Borg(),\\n)\\n)\\n```\\n## Execution\\n\\nWe start with execution as it is the part which has changed the most. We changed how hyperparameters are passed, allowed different arguments for binaries, removed the notion of server-driven hyperparameter sweep, which allows work units to differ in any aspect...\\n\\nTo make examples concise and fast, let's prebuild an executable to reuse:\\n\\n```python\\n%hide_all_output\\n\\n[executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/executables:echo_fragmented_mpms',\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n)\\n])\\n```\\nNow, to launch it on Borg we create an `xm.Job` which consists of an executable to run and parameters to pass:\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Simple single binary example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n# Anything we add to an experiment becomes a work unit.\\nexperiment.add(\\n# This xm.Job would become a Borg job.\\nxm.Job(\\n# What binary to run.\\nexecutable,\\n# These are command line parameters.\\n# Unlike legacy API they really are passed through command line.\\nargs\\u003d{\\n'learning_rate': 0.01,\\n'batch_size': 32,\\n},\\n# Environment variables can be set similar to CLI arguments.\\nenv_vars\\u003d{'XLA_FLAGS': '--xla_dump_hlo_as_proto'},\\n# And we tell API that we want to run on Borg.\\n# GCP is another possible choice.\\nexecutor\\u003dxm_abc.Borg(),\\n)\\n)\\n```\\nMany experiments need to run multiple jobs in a work unit. This can be done using `xm.JobGroup`. The following code launches two jobs: one named `learner` and one named `actor` each with its own command line arguments.\\n\\n`xm.JobGroup` supersedes `xm.ParallelExecutable`.\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'JobGroup example', attribution_urls\\u003d['rh/efforts/1910']\\n) as experiment:\\nexperiment.add(\\nxm.JobGroup(\\nlearner\\u003dxm.Job(\\nexecutable, args\\u003d{'learning_rate': 0.01}, executor\\u003dxm_abc.Borg()\\n),\\nactor\\u003dxm.Job(\\nexecutable, args\\u003d{'batch_size': 32}, executor\\u003dxm_abc.Borg()\\n),\\n)\\n)\\n```\\nIf you open the experiment page, you may notice that hyperparameters now look a bit different:\\n\\n\\u003e args.batch_size: **32** args.learning_rate: **0.01** env_vars.XLA_FLAGS: **--xla_dump_hlo_as_proto**\\n\\nOr even:\\n\\n\\u003e actor.args.batch_size: **32** learner.args.learning_rate: **0.01**\\n\\nAs hyperparameters may differ between binaries and are not necessary CLI arguments we have to add prefixes like `learner.args`. If needed, it is possible to **decouple** hyperparameters from how they are passed to binaries. We call it 'job generators'.\\n\\nSuppose we want to compare V100 and P100 performance:\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'V100 vs P100', attribution_urls\\u003d['rh/efforts/1910']\\n) as experiment:\\n\\n# We define a function which creates a work unit.\\n# Its parameters would become hyperparameters.\\nasync def make_job(\\nwork_unit: xm.WorkUnit, gpu: xm.GpuType, batch_size: int\\n) -\\u003e None:\\nwork_unit.add(\\nxm.Job(\\nexecutable,\\nargs\\u003d{'batch_size': batch_size},\\nexecutor\\u003dxm_abc.Borg(\\nxm.JobRequirements({gpu: 1}, service_tier\\u003dxm.ServiceTier.BATCH)\\n),\\n)\\n)\\n\\n# And pass this function instead of xm.Job.\\nexperiment.add(make_job, args\\u003d{'gpu': xm.GpuType.V100, 'batch_size': 4})\\nexperiment.add(make_job, args\\u003d{'gpu': xm.GpuType.P100, 'batch_size': 4})\\n```\\nThe job generator parameters become work unit hyperparameters:\\n\\n\\u003e batch_size: **4** gpu: **V100**\\n\\nAnd can be passed to the binaries in whatever form seems appropriate. You can launch completely different workloads depending on parameters given. The job generators provide a noteworthy feature: the `work_unit` argument provides access to a work unit id before the work unit has been initialized. It can be used in arbitrary Python code: no more magic BCL late-bindings.\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Autoselection example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n\\nasync def make_job(work_unit: xm.WorkUnit) -\\u003e None:\\n# We select a cell where to run the work unit.\\n[requirements] \\u003d rs.select(rs.Job([rs.Borg()]))\\n\\n# And construct a checkpoint path based on it, XID and WID.\\ncheckpoint_path \\u003d (\\nf'/cns/{requirements.location}-d/home/{experiment.context.creator}/'\\nf'{experiment.experiment_id}/{work_unit.work_unit_id}/'\\n)\\n\\nwork_unit.add(\\nxm.Job(\\nexecutable,\\nargs\\u003d{'checkpoint_path': checkpoint_path},\\nexecutor\\u003dxm_abc.Borg(requirements\\u003drequirements),\\n)\\n)\\n\\nexperiment.add(make_job)\\n```\\nNOTE: Since selection happens inside the job generator, the cell is picked individually for each work unit. **We spread the load between multiple cells**. If this is not what you require, you can `rs.select` once on experiment level. To learn more about the new 'Autoselection' see the chapter below.\\n\\n## Hyperparameter sweeps\\n\\nWe dropped support for server-side hyperparameter sweeps. Instead you can call `add` as many times as you need:\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Hyperparameter sweep example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\nexperiment.add(\\nxm.Job(executable, args\\u003d{'learning_rate': 0.1}, executor\\u003dxm_abc.Borg())\\n)\\nexperiment.add(\\nxm.Job(executable, args\\u003d{'learning_rate': 0.01}, executor\\u003dxm_abc.Borg())\\n)\\n\\n# For sweeping over ranges consider using a loop:\\nfor batch_size in:\\nexperiment.add(\\nxm.Job(\\nexecutable, args\\u003d{'batch_size': batch_size}, executor\\u003dxm_abc.Borg()\\n)\\n)\\n```\\nIt does work with good old `hyper` too:\\n\\n```python\\nfrom google3.learning.deepmind.xmanager import hyper\\n\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Hyper interoperability example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\nsweep \\u003d hyper.product([\\nhyper.sweep('learning_rate', hyper.discrete([1e-2, 1e-1])),\\nhyper.sweep('batch_size', hyper.discrete()),\\n])\\nfor args in sweep:\\nexperiment.add(xm.Job(executable, args\\u003dargs, executor\\u003dxm_abc.Borg()))\\n```\\nIt is now possible to add work units to an existing experiment, though we do require all executables to be built from the same citc snapshot, making this feature mostly usable from parameter controllers.\\n\\n```python\\n# We could have reused the `experiment` object, but let's suppose we only have XID.\\nxid \\u003d experiment.experiment_id\\n\\nwith xm_abc.get_experiment(xid) as experiment:\\n# Add a work unit to the experiment created in the previous cell.\\nexperiment.add(\\nxm.Job(executable, args\\u003d{'batch_size': 128}, executor\\u003dxm_abc.Borg())\\n)\\n```\\nRather than specifying `args` or `env_vars` when creating the `Job`, it's also possible to pre-construct the job and supply them as `args` to the `experiment.add` call. This provides a universal way to parameterize jobs for optimization frameworks.\\n\\n```python\\nwith experiment:\\njob \\u003d xm.Job(executable, executor\\u003dxm_abc.Borg())\\n# `args` given to `add` are recursively expanded and applied to the given job.\\n# In this case {'args': {'batch_size': 4}} adds 'batch_size' keys to job.args\\n# property. If instead of {'args':...} a {'env_vars':...} was used, we would\\n# sweep over environment variables.\\nexperiment.add(job, args\\u003d{'args': {'batch_size': 4}})\\n```\\n## Hyperparameter tuning with Vizier\\n\\nSupersedes VizierSearchV2.\\n\\nUse `vizier_abc.vizier_controller()` to construct the controller and add it to\\nexperiment as an auxiliary job.\\n\\nWe support three modes of study experimentation. Use `vizier_abc.NewStudy()`,\\n`vizier_abc.ResumeStudy()`, or `vizier_abc.ReplayStudy()` to configure it.\\n\\n```python\\nfrom xmanager.vizier import vizier_abc\\nfrom google3.learning.vizier.service.client import pyvizier\\n\\n\\ndef get_study_config() -\\u003e pyvizier.StudyConfig:\\n```Get Vizier study_config.```\\nstudy_config \\u003d pyvizier.StudyConfig()\\n\\nsearch_space_root \\u003d study_config.search_space.select_root()\\nsearch_space_root.add_float_param(\\nname\\u003d'args.x',  # prefix the parameter you want to tune with 'args.'\\nmin_value\\u003d1.0,\\nmax_value\\u003d100.0,\\nscale_type\\u003dpyvizier.ScaleType.LOG,\\n)\\nsearch_space_root.add_discrete_param(\\nname\\u003d'args.y',  # prefix the parameter you want to tune with 'args.'\\nfeasible_values\\u003dlist(range(-10, 10)),\\nscale_type\\u003dpyvizier.ScaleType.UNIFORM_DISCRETE,\\n)\\n\\nstudy_config.metric_information \\u003d [\\npyvizier.MetricInformation(\\nname\\u003d'loss', goal\\u003dpyvizier.ObjectiveMetricGoal.MINIMIZE\\n)\\n]\\n\\nstudy_config.study_stopping_config \\u003d pyvizier.StudyStoppingConfig(\\nmax_num_trials\\u003d10\\n)\\n\\nreturn study_config\\n\\n\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Launch Vizier with New Study',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n\\n[polynomial_executable] \\u003d experiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/vizier:polynomial',\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n),\\n])\\n\\njob \\u003d xm.Job(executable\\u003dpolynomial_executable, executor\\u003dxm_abc.Borg())\\nstudy_factory \\u003d vizier_abc.NewStudy(get_study_config())\\n\\nexperiment.add(\\nvizier_abc.vizier_controller(\\njob, study_factory, num_parallel_work_units\\u003d3\\n)\\n)\\n```\\nNOTE: In light of the 'eager' work unit creation, New Launch API Vizier starts\\nto create work units early by kicking off the controller run locally once\\neverything is built while waiting controller on borg to start. The local run\\nwill stop once the borg run starts. This saves at least 1 minute on average to\\nkick off your first work unit creation.\\n\\n## Packaging\\n\\nA variety of executables can be packaged and run through XManager launch API. Some, like `xm.bazel_binary` are available both in internal and OSS versions. Others, like `xm_abc.interpreter` are google specific.\\n\\n### Blaze / Bazel binary\\n\\nSupersedes: `xm.BuildTarget`, `xm.FragmentedPythonPackage`\\n\\nUse `xm.bazel_binary` to build a binary with Blaze. We use blaze internally and bazel in OSS version.\\n\\nNote that Blaze build flags need to be explicitly specified, since when packaging is done, Launch API doesn't know what platform it will be running on. We provide default flags for all platforms through `xm_abc.bazel_args`.\\n\\n```python\\n[bazel_binary_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/executables:echo',\\nbazel_args\\u003dxm_abc.bazel_args.gpu(),\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n)\\n])\\n```\\nFragmented MPMs [go/fragmented-python] can also be packaged through `xm.bazel_binary`. We recommend using them over regular.par due to a much better [REPL](https://en.wikipedia.org/wiki/Read%E2%80%93eval%E2%80%93print_loop) speed. Also fragmented MPMs can be built by BuildRabbit, so can be launched from colab running on Borg.\\n\\n```python\\n[fragmented_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//learning/deepmind/xmanager2/examples/dm_cifar10/train:cifar10_train_fragmented_mpms',\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n)\\n])\\n```\\n### Prebuilt Mpm\\n\\nSupersedes: `xm.Binary`\\n\\nUse `xm.prebuilt_mpm` to refererence a prebuilt mpm package.\\n\\n```python\\n[prebuilt_mpm_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm_abc.prebuilt_mpm(\\nname\\u003d'learning/brain/tensorboard',\\nversion\\u003d'live',\\nbinary_path\\u003d'tensorboard.par',\\nargs\\u003d{'port': '%port%'},\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n)\\n])\\n```\\n### Packaging multiple binaries\\n\\nTo package multiple binaries you will need to pass several specifications to `experiment.package`: built executables will be returned in corresponding order. That way they will be built in parallel\\n\\n```python\\n[gpu_executable, tpu_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/executables:echo',\\nbazel_args\\u003dxm_abc.bazel_args.gpu(),\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n),\\nxm.bazel_binary(\\nlabel\\u003d'//third_party/py/xmanager/examples/alphabet/executables:echo',\\nbazel_args\\u003dxm_abc.bazel_args.tpu(),\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\n),\\n])\\n```\\n### Dependencies aka config resources\\n\\nSupersedes: `xm.LocalFile`, `xm.Directory`, `xm.BuildTargetResource`\\n\\nIf a binary needs some files to run, these can be packaged using `xm_abc.Fileset`. The fileset needs to be listed in `dependencies` parameter. Note that `xm_abc.Borg.Spec()` has to be given to `config_resource.get_path`. That is because the path would be different on other platforms, such as GCP.\\n\\n```python\\nproject_path \\u003d 'learning/deepmind/xmanager2/examples/dm_cifar10/train'\\nconfig_resource \\u003d xm_abc.Fileset(\\n# Dict from a path in google3 to a path in the package.\\nfiles\\u003d{f'//{project_path}/config.py': 'config.py'}\\n)\\n[executable_with_config] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003df'//{project_path}:cifar10_train',\\ndependencies\\u003d[config_resource],\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\nbazel_args\\u003dxm_abc.bazel_args.gpu(),\\nargs\\u003d{\\n'config': config_resource.get_path('config.py', xm_abc.Borg.Spec()),\\n},\\n),\\n])\\n```\\nIf you are using fragmented MPMs the files can be embedded into them:\\n\\n```python\\nproject_path \\u003d 'learning/deepmind/xmanager2/examples/dm_cifar10/train'\\n[fragmented_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm.bazel_binary(\\nlabel\\u003df'//{project_path}:cifar10_train_fragmented_mpms',\\nbazel_args\\u003dxm_abc.bazel_args.gpu(),\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\nargs\\u003d{\\n'config': xm_abc.get_fragmented_mpm_path(\\nf'{project_path}/config.py', xm_abc.Borg.Spec()\\n),\\n},\\n),\\n])\\n```\\nIf your executable needs resources that can be obtained from build targets (for\\nexample, other binaries that will be launched in a subprocess, files defined in\\ngenmpm target, etc), you can use xm_abc.BazelDependency to refer to them.\\n\\n```python\\nproject_path \\u003d 'learning/deepmind/xmanager2/examples/cifar10/train'\\nconfig_resource \\u003d xm_abc.BazelDependency(\\nbazel_label\\u003df'//{project_path}:config_files_mpm'\\n)\\n[executable_with_dependencies] \\u003d experiment.package([\\nxm.bazel_binary(\\nlabel\\u003df'//{project_path}:cifar10_train',\\ndependencies\\u003d[config_resource],\\nexecutor_spec\\u003dxm_abc.Borg.Spec(),\\nbazel_args\\u003dxm_abc.bazel_args.gpu(),\\nargs\\u003d{\\n'config': config_resource.get_path('config.py', xm_abc.Borg.Spec()),\\n},\\n),\\n])\\n```\\n### Interpreter workflow\\n\\nSupersedes: `xm.DMPythonScript`, `xm.MLPythonScript`, `xm.LocalG3Packages`\\n\\nTo avoid long compilation time you can use a prebuilt python interpreter to launch python scripts: go/xm-compile-free-workflow. It achieves great REPL speed at the expense of compromised correctness and hermeticity.\\n\\n```python\\n[interpreter_executable] \\u003d xm_abc.XManagerExperiment.package([\\nxm_abc.interpreter(\\n'//learning/deepmind/xmanager2/examples/dm_cifar10/train/cifar10_train.py',\\nadhoc_import_modules\\u003d['google3.learning.deepmind.xmanager2.client'],\\n# NOTE: Non DeepMind users are advised to use xm_abc.ml_python().\\ninterpreter_mpm\\u003dxm_abc.dm_python(),\\n)\\n])\\n```\\n### Legacy executables\\n\\nTo make migration to the new API easier there is a limited support for executables defined through the legacy API. It allows to migrate execution code, validate that it works and then migrate packaging. Legacy and new style executables can't be intermixed and there is no packaging stage for `LegacyExecutable's`. Launching with them is also slow.\\n\\n```python\\nimport google3.learning.deepmind.xmanager as old_xm\\n\\nlegacy_executable \\u003d xm_abc.LegacyExecutable(\\nold_xm.BuildTarget(\\n'//third_party/py/xmanager/examples/alphabet/executables:echo'\\n)\\n)\\n\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Legacy executable example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\nexperiment.add(xm.Job(legacy_executable, executor\\u003dxm_abc.Borg()))\\n```\\n## Resource requirements\\n\\nBy default jobs would be launched on CPU and their resource requirements would be automatically deduced. To run on accelerators you need to pass `xm.JobRequirements` object to the executor:\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Resource requirements example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n# A RAM hungry job (please use xm.GiB to improve readability):\\nexperiment.add(\\nxm.Job(\\nexecutable, executor\\u003dxm_abc.Borg(xm.JobRequirements(ram\\u003d10 * xm.GiB))\\n)\\n)\\n# A GPU job:\\nexperiment.add(\\nxm.Job(executable, executor\\u003dxm_abc.Borg(xm.JobRequirements(v100\\u003d1)))\\n)\\n# A TPU job:\\nexperiment.add(\\nxm.Job(\\nexecutable, executor\\u003dxm_abc.Borg(xm.JobRequirements(dragonfish\\u003d'4x4'))\\n)\\n)\\n```\\nRequirements can be constructed through keyword arguments or from a dict. Both strings and enums are supported. Enums are type safe and checked at compile time while strings work well with existing flags.\\n\\n```python\\n# All of these are the same:\\nxm.JobRequirements(dragonfish\\u003d'4x4')\\nxm.JobRequirements({'dragonfish': '4x4'})\\nxm.JobRequirements({xm.ResourceType.DRAGONFISH: '4x4'})\\n```\\nWe also have defined aliases for widely used resource names, such as `df` or `tpu_v3`.\\n\\n```python\\nxm.JobRequirements(df\\u003d'4x4')\\nxm.JobRequirements(tpu_v3\\u003d'4x4')  # External name for DragonFish.\\nxm.JobRequirements({xm.ResourceType.DF: '4x4'})\\nxm.JobRequirements({xm.TpuType.DF: '4x4'})\\n```\\n`xm.JobRequirements` also store other aspects, like location where to run the job or what Borg priority to set. After some considerations we decided to use `location` instead of `cell` because latter is Borg specific so it doesn't fit GCP and is not open-sourceable.\\n\\n```python\\nxm.JobRequirements(\\n# Run in specified cell.\\nlocation\\u003d'el',\\n# At batch priority.\\nservice_tier\\u003dxm.ServiceTier.BATCH,\\n# 100 replicas of this job.\\nreplicas\\u003d100,\\n)\\n```\\nThe `xm.JobRequirements` is inspectable:\\n\\n```python\\nrequirements \\u003d xm.JobRequirements(dragonfish\\u003d'4x4', location\\u003d'el')\\nprint(\\nf'{requirements.accelerator}: {requirements.topology} in'\\nf' {requirements.location}'\\n)\\nif requirements.accelerator in xm.TpuType:\\nprint('This is a TPU job.')\\nif requirements.accelerator in xm.GpuType:\\nprint('This is a GPU job.')\\n\\ncpu_requirements \\u003d xm.JobRequirements(cpu\\u003d2.0, replicas\\u003d100)\\nprint(\\nf'A single replica of a CPU task needs {cpu_requirements.task_requirements}'\\n)\\n```\\n## Autoselection\\n\\nWe've adopted Launchpad approach to automatic selection. There is a separate library which supports picking of cells or accelerators and then providing concrete values.\\n\\n```python\\nrequirements \\u003d xm.JobRequirements(dragonfish\\u003d'4x4')\\n[requirements] \\u003d rs.select(rs.Job(requirements\\u003drequirements))\\nprint(f'This job would fit in cell {requirements.location}.')\\n```\\nAlternatively a more comprehensive set of constraints can be specified:\\n\\n```python\\nrs.select(\\nrs.Job(\\nconstraints\\u003d[\\nrs.Location(exclude\\u003d['nm']),\\nrs.Gpu(['V100', 'P100']),\\nrs.Borg(),\\n]\\n)\\n)\\n```\\nNote that by running autoselection for each work unit it is possible to spread them between the cells, better utilizing available resources.\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Autoselection example',\\nattribution_urls\\u003d['rh/efforts/1910'],\\n) as experiment:\\n\\nasync def make_job(work_unit: xm.WorkUnit) -\\u003e None:\\n# Passing the same rs.Location constraint object to both rs.Jobs forces\\n# them to be located in the same location.\\nlocation_constraint \\u003d rs.Location(exclude\\u003d['nm'])\\nlearner_requirements, actor_requirements \\u003d rs.select(\\nrs.Job([\\nlocation_constraint,\\n# xm.ResourceType enums are also accepted.\\nrs.Gpu(['V100', 'P100']),\\nrs.Borg(),\\n]),\\nrs.Job(\\n[location_constraint, rs.Borg()],\\nxm.JobRequirements(ram\\u003d50 * xm.GiB),\\n),\\n)\\n\\nwork_unit.add(\\nxm.JobGroup(\\nlearner\\u003dxm.Job(\\nexecutable,\\nargs\\u003d{'learning_rate': 0.01},\\nexecutor\\u003dxm_abc.Borg(requirements\\u003dlearner_requirements),\\n),\\nactor\\u003dxm.Job(\\nexecutable,\\nargs\\u003d{'batch_size': 32},\\nexecutor\\u003dxm_abc.Borg(requirements\\u003dactor_requirements),\\n),\\n)\\n)\\n\\nexperiment.add(make_job)\\n```\\n## Metadata (tags, notes, etc...)\\n\\nSupersedes: `xm.ExperimentDescription`\\n\\nWe have aligned experiment metadata API with go/actx. Though the syntax is now more verbose, it allows us to maintain a consistent metadata API for all aspects of the experiment (e.g. computations running inside a work unit). Both `Experiment` and `WorkUnit` have a `context` property used to access and manipulate metadata.\\n\\n```python\\nwith xm_abc.create_experiment(\\nexperiment_title\\u003d'Metadata example', attribution_urls\\u003d['rh/efforts/1910']\\n) as experiment:\\n\\nannotations \\u003d experiment.context.annotations\\nannotations.add_tags('demo', 'metadata')\\nannotations.set_notes('This example demonstrates metadata manipulation')\\n\\nprint(f'This experiment is attributed to {annotations.attribution_urls}.')\\n\\nasync def make_job(work_unit: xm.WorkUnit) -\\u003e None:\\nannotations \\u003d work_unit.context.annotations\\nannotations.add_tags('baseline')\\nwork_unit.add(xm.Job(executable, executor\\u003dxm_abc.Borg()))\\n\\nexperiment.add(make_job)\\n```\\n\\n\\n\\n\\nI/O Cookbook: Protos, RecordIO, SSTable, Bigtable, shell\\n```python\\nfrom colabtools import interactive_table, mpm, proto\\nfrom google3.file.recordio.python import recordio\\nfrom google3.bigtable.contrib.python import bigtable\\nimport os\\n\\nprint('Done')\\n```\\nShell\\nYou can execute shell commands using the `%%shell` cell magic. For example, suppose we want to inspect some sample [`GWSLogEntry`](https://cs.corp.google.com/#piper///depot/google3/logs/gws/gwslog.proto) logs using [`gqui`](http://go/gqui).\\n\\nThese are drawn from a set of [sanitized examples logs](https://wiki.corp.google.com/twiki/bin/view/Main/LearningLogs). The original copies are in `/google/data/ro/projects/logs/learning`.\\n\\n```bash\\n%%shell\\n\\ngqui -color always -custom_colors 'key\\u003dred;comment\\u003dgreen'   from /cns/ok-d/home/colab/example/gwslog/gws.2005.04.01.weblogs@1   proto GWSLogEntryProto   limit 1\\n```\\nUsing the `%%def` magic, you can combine Python and shell with variable substitution.\\n\\n```python\\n%%def py_echo(s):\\n%%shell\\necho $USER says {s}\\n```\\n```python\\npy_echo('echo')\\n```\\nProtos, RecordIO\\nYou can use the [standard google3 Python](https://wiki.corp.google.com/twiki/bin/view/Codelab/ProtocolBuffersML?pl\\u003dpy) to work with protos in coLab, but it's often easier to use coLab's built-in helpers for reading them.\\n\\n```python\\n%output_height 300\\n\\n# You can any proto in the global proto DB here.\\nGWSLogProtoEntry \\u003d proto.LookupMessage('GWSLogEntryProto')\\n\\n# Read and print the first entry from the example logs.\\nrr \\u003d recordio.RecordReader('/cns/ok-d/home/colab/example/gwslog/gws.2005.04.01.weblogs-00000-of-00001')\\nentry \\u003d GWSLogProtoEntry()\\nentry.ParseFromString(rr.next())\\nprint(entry)\\n```\\nYou can also construct protos by hand using the `%%parse_proto` magic, complete with contextual auto-complete!\\n\\n```python\\n# Pick up the proto extensions.\\n_ \\u003d proto.db.hivemind.PredictSearchParams.message_set_extension\\n```\\n```python\\n%%parse_proto GenericSearchRequest parsed\\nquery: 'q\\u003dwhy do whales breach'\\nnum: 100\\nnum_to_score: 100000\\nparams \\u003c\\n[hivemind.PredictSearchParams] \\u003c\\ndistribution_spec: 's2\\u003d100,default\\u003d0'\\nencoding:EXPANDED_FULL\\n\\u003e\\n\\u003e\\n```\\n```python\\nprint(str(parsed))\\n```\\nColab's proto library also includes a pretty-printer. Try folding various sub-messages.\\n\\n```python\\nproto.PrintProto(parsed)\\n```\\nBigtable\\nYou can interact with Bigtable using both the `bt` shell command as well as standard google3 Python libraries, which are included with coLab.\\n\\n```python\\n# Install the 'bt' command-line client and add it to the system path.\\nbt_mpm_dir \\u003d mpm.fetch('bigtable/bt')\\nos.environ['PATH'] +\\u003d os.pathsep + bt_mpm_dir\\n```\\n```bash\\n%%shell\\n\\nexport TBL\\u003d'/bigtable/test/$USER.bigtable-colab'\\n\\nbt createtable $TBL\\nbt createfamily $TBL test_family:string\\nbt getschema $TBL\\n```\\n```python\\nname \\u003d '/bigtable/test/{}.bigtable-colab'.format(os.getenv('USER'))\\ntable \\u003d bigtable.Open(name).Run()\\n\\n# Write.\\nfor i in range(5):\\nop \\u003d table.Set(f'row{i}', {'test_family': f'data{i}'}, replace\\u003d1)\\nop.Run()\\n\\n# Read.\\nscanner \\u003d table.Scanner()\\nscan_stream \\u003d scanner.FetchColumnPrefix('test_family:')\\nfor row in scanner:\\nfor value in scan_stream:\\nprint(f'{row.decode('ascii')} - {value.decode('ascii')}')\\n```\\nWe clean up our example table with the `bt` command.\\n\\n```bash\\n%%shell\\n\\nbt deletetable --f /bigtable/test/$USER.bigtable-colab\\n```\\nSSTable\\nYou can use the standard python sstable library to read sstables. For example we can read digit data from from the [Brain Codelab](http://go/brain-colab).\\n\\n```python\\nfrom google3.sstable.python import sstable\\n\\nImage \\u003d proto.LookupMessage('dist_belief.Image')\\nfilename \\u003d '/placer/prod/home/distbelief/mnist/datasets/randomized-mnist-images-00000-of-00001'\\ntable \\u003d sstable.SSTable(filename,\\nwrapper\\u003dsstable.TableWrapper(Image.FromString))\\ntable\\n```\\nSince colab lives in the browser you can display it with interactive javascript like the interactive table below.\\n\\n```python\\nimport itertools\\nfrom colabtools import interactive_table, formatters\\n\\n# produce visualization for a subset of roughly 100 entries:\\nstart_key \\u003d ''\\nstop_key\\u003d None\\nmax_items \\u003d 100\\ndef columns_extractor(item):\\nkey, value \\u003d item\\n\\nelements \\u003d [key.decode('ascii'), # sstable key\\nformatters.FormatRawImage(value.raw_image_string,\\n(value.width, value.height),\\ndisplay_width\\u003d28), # format an image\\nvalue.label_proto.target_class]\\nreturn elements\\n\\ndata \\u003d itertools.islice(table.iteritems(start\\u003dstart_key, stop\\u003dstop_key), max_items)\\ninteractive_table.FromData(data\\u003ddata,\\nextractor\\u003dcolumns_extractor,\\ncolumns\\u003d['key', 'image', 'label'])\\n```\\nYou can also write to SSTables. The following will write a sharded SSTable mapping string integers to (string representations of) their Python hashes. (Unsharded SSTables can be built without specifying a sharder using `sstable.SortingBuilder`.)\\n\\n```python\\nimport os\\nimport random\\nimport tempfile\\n\\nfrom google3.file.base.python import shards\\nfrom google3.sstable.python import sharded_builder\\nfrom google3.sstable.python import sstable\\nfrom google3.sstable.python import sstable_sharder\\n\\n\\noutput_dir \\u003d tempfile.mkdtemp()  # Or '/cns/...'\\nshard_spec \\u003d os.path.join(output_dir, 'random@10')\\nshard_paths \\u003d shards.GenerateShardedFilenames(shard_spec)\\nsharder \\u003d sstable_sharder.SSTable_SharderFactory.New(\\n'SSTable_KeyFingerprintSharder')\\n\\nwith sharded_builder.SortingShardedBuilder(shard_paths, sharder) as builder:\\nfor i in range(10000):\\nbuilder.Add(str(i), str(hash(str(i))))\\n```\\nNow we can read the data back.\\n\\n```python\\ntable \\u003d sstable.SSTable(\\nshard_spec, wrapper\\u003dsstable.TableWrapper(lambda x: x.decode('ascii')))\\nfor i in range(10000):\\nassert str(hash(str(i))) \\u003d\\u003d table.Get(str(i))\\n```\\n\\nYou are an expert software engineer and data scientist with expertise in Python, Google Colaboratory and Jupyter notebooks. You will follow these rules strictly.\\n\\n- Use 2 spaces for indentation.\\n- Given preceding code, and task, respond with code that works with Google Colaboratory or Jupyter Notebooks only.\\n- Prefix all shell commands with `!` e.g., `pip install` will become `!pip install`.\\n- Shell commands are never indented, no whitespace at the beginning of the line.\\n- Do not have a whitespace at the beginning of a new line unless it is valid indentation.\\n- Import libraries if they are not imported.\\n- Preceding code may not always be relevant to the Task. If it is not relevant, you must write code that does not have previous context. If it is relevant, write code with preceding code as context.\\n- **Returned code should contain only valid Python code requested by the task, avoiding redundancy and any additional examples or explanations. No markdown. Comments are allowed.**\\n- Some imports might be from google3 and not standard python.\\n- In your response, do not repeat the provided preceding code or any other placeholders, and just give the new code.\\u003cctrl100\\u003e\\n\",\"\\n\\n\",\"\\u003cctrl99\\u003euser\\n### Preceding code:\\n[[preceding]]\\n### Task:\\n[[task]]\\n### Answer with code:\\u003cctrl100\\u003e\\n\\u003cctrl99\\u003emodel\\n```python\\n[[answer]]\\n```\\u003cctrl100\\u003e\",[null,null,2048,[\"\\u003cctrl98\\u003e\"]]]"))),
